### Pool Lifecycle Management
```gdscript
# ✅ GOOD: Complete pool lifecycle implementation
class_name BulletPool extends Node

var _active_bullets: Array[Bullet] = []
var _inactive_bullets: Array[Bullet] = []
var _pool_size: int = 200

func _ready() -> void:
    # Pre-allocate entire pool at startup
    for i in range(_pool_size):
        var bullet := Bullet.new()
        bullet.visible = false
        bullet.process_mode = Node.PROCESS_MODE_DISABLED
        add_child(bullet)
        _inactive_bullets.append(bullet)

func acquire() -> Bullet:
    if _inactive_bullets.is_empty():
        # Pool exhausted - degrade gracefully
        return null
    
    var bullet := _inactive_bullets.pop_back()
    _active_bullets.append(bullet)
    
    # Activate bullet (no allocation)
    bullet.visible = true
    bullet.process_mode = Node.PROCESS_MODE_INHERIT
    
    return bullet

func release(bullet: Bullet) -> void:
    # Deactivate bullet (no deallocation)
    bullet.visible = false
    bullet.process_mode = Node.PROCESS_MODE_DISABLED
    bullet.position = Vector2.ZERO
    bullet.velocity = Vector2.ZERO
    
    # Move between pools
    var index := _active_bullets.find(bullet)
    if index != -1:
        _active_bullets.remove_at(index)
    _inactive_bullets.append(bullet)

# ❌ BAD: Incomplete pooling with allocations
func release(bullet):
    bullet.queue_free()  # Defeats the purpose of pooling!
    _active_bullets.erase(bullet)
```

### Pool Reuse Pattern
```gdscript
# ✅ GOOD: Complete state reset for reused objects
func reset_for_pool() -> void:
    # 1. Disconnect ALL signals (critical for avoiding leaks)
    for connection in get_incoming_connections():
        var sig: Signal = connection.signal
        if sig.is_connected(connection.callable):
            sig.disconnect(connection.callable)
    
    # 2. Reset position and physics
    global_position = Vector2.ZERO
    velocity = Vector2.ZERO
    rotation = 0.0
    scale = Vector2.ONE
    
    # 3. Reset gameplay state
    damage = 0
    lifetime = 0.0
    is_player_bullet = false
    
    # 4. Clear references (prevent memory leaks)
    target_node = null
    source_node = null
    
    # 5. Reset visual state
    modulate = Color.WHITE
    visible = false
    
    # 6. Disable processing
    process_mode = Node.PROCESS_MODE_DISABLED
    set_physics_process(false)
    set_process(false)

# ❌ BAD: Incomplete reset leaves stale state
func reset_for_pool() -> void:
    position = Vector2.ZERO
    # Forgot: signals, velocity, references, processing state!
```

## Rate Limiting

### Bullet Spawn Rate Limiting
```gdscript
# ✅ GOOD: Rate limiter with per-second caps
class_name RateLimiter extends Node

@export var max_per_second: int = 300
@export var burst_allowance: int = 50

var _spawn_count_this_second: int = 0
var _time_accumulator: float = 0.0

func _process(delta: float) -> void:
    _time_accumulator += delta
    if _time_accumulator >= 1.0:
        _time_accumulator = 0.0
        _spawn_count_this_second = 0

func can_spawn() -> bool:
    if _spawn_count_this_second >= max_per_second + burst_allowance:
        return false
    return true

func register_spawn() -> void:
    _spawn_count_this_second += 1

# Usage in spawn logic
func fire_bullet() -> void:
    if not rate_limiter.can_spawn():
        # Degrade gracefully - skip this bullet
        return
    
    var bullet := EntityFactory.spawn_bullet("enemy_basic", position, direction)
    if bullet != null:
        rate_limiter.register_spawn()

# ❌ BAD: No rate limiting - performance spikes
func fire_bullet_pattern():
    for i in range(360):  # 360 bullets at once!
        var bullet = EntityFactory.spawn_bullet(...)
```

### Graceful Degradation
```gdscript
# ✅ GOOD: Skip non-critical spawns when under load
func spawn_enemy_wave() -> void:
    var active_count := _get_active_bullet_count()
    
    if active_count > 400:
        # High load - reduce spawn rate
        if randf() > 0.5:
            return  # Skip 50% of spawns
    
    if active_count > 600:
        # Critical load - skip all non-essential spawns
        push_warning("[Spawner] High bullet count (%d), skipping enemy spawn" % active_count)
        return
    
    var enemy := EntityFactory.spawn_enemy("popcorn_01", position, direction)

# ✅ GOOD: Reduce visual effects under load
func spawn_hit_particles(position: Vector2) -> void:
    if _get_active_particle_count() > 50:
        return  # Skip particles when too many active
    
    var particles := EntityFactory.spawn_effect("hit_spark", position)

# ❌ BAD: No degradation - guaranteed frame drops
func spawn_wave():
    for i in range(100):  # Always spawn 100, even if lagging
        spawn_enemy()
```

## Per-Frame Performance Optimization

### Cache Node References
```gdscript
# ✅ GOOD: Cached references with lazy initialization
var _cached_player: Player = null
var _cached_game_state: GameState = null

func _get_player() -> Player:
    if not is_instance_valid(_cached_player):
        _cached_player = get_tree().get_first_node_in_group("player") as Player
    return _cached_player

func _physics_process(delta: float) -> void:
    var player := _get_player()
    if player == null:
        return
    
    # Use cached reference (no tree traversal)
    var direction_to_player := (player.global_position - global_position).normalized()
    velocity = direction_to_player * speed

# ❌ BAD: Repeated node lookups every frame
func _physics_process(delta: float) -> void:
    var player = get_node("/root/Main/Player")  # Tree traversal every frame!
    var direction = (player.position - position).normalized()
```

### Avoid Allocations in Process Functions
```gdscript
# ✅ GOOD: Reuse vectors, no allocations
var _direction_cache: Vector2 = Vector2.ZERO
var _velocity_cache: Vector2 = Vector2.ZERO

func _physics_process(delta: float) -> void:
    # Reuse cached vectors
    _direction_cache = (_target_position - global_position).normalized()
    _velocity_cache = _direction_cache * speed
    global_position += _velocity_cache * delta

# ❌ BAD: Allocates new vectors every frame
func _physics_process(delta: float) -> void:
    var direction = (_target_position - global_position).normalized()  # Allocation
    var velocity = direction * speed  # Another allocation
    global_position += velocity * delta  # Another allocation
```

### Batch Operations
```gdscript
# ✅ GOOD: Batch processing with early outs
func update_all_bullets(delta: float) -> void:
    # Iterate backwards to allow safe removal
    for i in range(_active_bullets.size() - 1, -1, -1):
        var bullet := _active_bullets[i]
        
        # Quick validity check
        if not is_instance_valid(bullet):
            _active_bullets.remove_at(i)
            continue
        
        # Update bullet
        bullet.position += bullet.velocity * delta
        
        # Bounds check (cheap operation first)
        if _is_out_of_bounds(bullet.position):
            _return_bullet_to_pool(bullet)
            _active_bullets.remove_at(i)

# ⚠️ CAUTION: Avoid nested loops over large collections
func check_all_collisions() -> void:
    # O(n*m) - expensive with 500 bullets and 50 enemies!
    for bullet in bullets:
        for enemy in enemies:
            if bullet.overlaps(enemy):
                _handle_collision(bullet, enemy)

# ✅ BETTER: Use spatial partitioning or quadtree
func check_all_collisions() -> void:
    var spatial_grid := _build_spatial_grid(enemies, 64)  # 64px cells
    
    for bullet in bullets:
        var nearby_enemies := spatial_grid.query(bullet.position, bullet.collision_radius)
        for enemy in nearby_enemies:
            if bullet.overlaps(enemy):
                _handle_collision(bullet, enemy)
```

### Minimize get_tree().get_nodes_in_group() Calls
```gdscript
# ❌ VERY BAD: Calling in _process (traverses entire tree every frame!)
func _process(delta: float) -> void:
    var enemies := get_tree().get_nodes_in_group("enemies")
    for enemy in enemies:
        _update_enemy(enemy)

# ✅ GOOD: Cache group and update via signals
var _enemy_cache: Array[Enemy] = []

func _ready() -> void:
    EventBus.enemy_spawned.connect(_on_enemy_spawned)
    EventBus.enemy_defeated.connect(_on_enemy_defeated)
    _refresh_enemy_cache()

func _refresh_enemy_cache() -> void:
    _enemy_cache.clear()
    _enemy_cache.append_array(get_tree().get_nodes_in_group("enemies"))

func _on_enemy_spawned(enemy: Enemy, _template_id: String) -> void:
    _enemy_cache.append(enemy)

func _on_enemy_defeated(_enemy_id: int, _pos: Vector2, _score: int) -> void:
    # Remove invalid entries on next process
    _cache_dirty = true

func _process(delta: float) -> void:
    if _cache_dirty:
        _enemy_cache = _enemy_cache.filter(func(e): return is_instance_valid(e))
        _cache_dirty = false
    
    for enemy in _enemy_cache:
        _update_enemy(enemy)
```

## Math Optimization

### Integer Math for Counters
```gdscript
# ✅ GOOD: Integer operations for counts
var bullet_count: int = 500
var half_bullets: int = bullet_count >> 1  # Bit shift (faster than division)
var quarter_bullets: int = bullet_count >> 2

# ✅ GOOD: Use int() for explicit integer division
var enemies_per_row: int = int(total_enemies / row_count)

# ⚠️ CAUTION: Default division returns float in GDScript 2.0
var result = 10 / 2  # Returns 5.0 (float), not 5 (int)
var correct_int_result: int = 10 // 2  # Returns 5 (int)
```

### Trigonometry Optimization
```gdscript
# ✅ GOOD: Pre-calculate trigonometric values
const ANGLE_STEP: float = TAU / 360.0
var _cos_table: Array[float] = []
var _sin_table: Array[float] = []

func _ready() -> void:
    # Build lookup tables at startup
    _cos_table.resize(360)
    _sin_table.resize(360)
    for i in range(360):
        var angle := i * ANGLE_STEP
        _cos_table[i] = cos(angle)
        _sin_table[i] = sin(angle)

func get_direction_from_angle(angle_degrees: int) -> Vector2:
    var index := angle_degrees % 360
    return Vector2(_cos_table[index], _sin_table[index])

# ❌ BAD: Calculating sin/cos every frame
func get_direction(angle: float) -> Vector2:
    return Vector2(cos(angle), sin(angle))  # Expensive!
```

### Vector Operations
```gdscript
# ✅ GOOD: Avoid sqrt when possible (use squared distance)
func is_in_range(target_pos: Vector2, max_range: float) -> bool:
    var dist_squared := global_position.distance_squared_to(target_pos)
    return dist_squared <= max_range * max_range

# ❌ BAD: Unnecessary sqrt calculation
func is_in_range(target_pos: Vector2, max_range: float) -> bool:
    var dist := global_position.distance_to(target_pos)  # sqrt inside!
    return dist <= max_range

# ✅ GOOD: Reuse normalized vectors
var _last_direction: Vector2 = Vector2.DOWN
var _direction_dirty: bool = true

func get_movement_direction() -> Vector2:
    if _direction_dirty:
        _last_direction = (_target_position - position).normalized()
        _direction_dirty = false
    return _last_direction
```

## Shader Performance

### Fragment Shader Optimization
```gdscript
# ✅ GOOD: Minimize per-pixel calculations in shaders
shader_type canvas_item;

uniform float time : hint_range(0, 100);
uniform vec2 resolution;

void fragment() {
    // Pre-calculate constants outside loops
    vec2 uv = UV;
    float aspect = resolution.x / resolution.y;
    
    // Avoid expensive operations like pow, sin, cos in hot paths
    vec2 centered_uv = (uv - 0.5) * 2.0;
    float dist = length(centered_uv);
    
    // Simple operations only
    COLOR.rgb *= 1.0 - dist * 0.1;
}

# ❌ BAD: Expensive per-pixel operations
void fragment() {
    for (int i = 0; i < 10; i++) {
        COLOR.rgb += texture(TEXTURE, UV + vec2(sin(TIME * float(i)))).rgb;
    }
    // This runs for EVERY pixel EVERY frame!
}
```

### Shader Parameter Updates
```gdscript
# ✅ GOOD: Update shader parameters sparingly
var _last_shader_update: float = 0.0
const SHADER_UPDATE_INTERVAL: float = 0.1  # 10 FPS for shader params

func _process(delta: float) -> void:
    _last_shader_update += delta
    if _last_shader_update >= SHADER_UPDATE_INTERVAL:
        _material.set_shader_parameter("time", Time.get_ticks_msec() * 0.001)
        _last_shader_update = 0.0

# ❌ BAD: Update every frame (60 FPS)
func _process(delta: float) -> void:
    _material.set_shader_parameter("time", Time.get_ticks_msec() * 0.001)
```

## Particle System Optimization

### GPU Particles vs CPU Particles
```gdscript
# ✅ GOOD: Use GPUParticles2D for many particles
var explosion_particles := GPUParticles2D.new()
explosion_particles.amount = 100  # GPU handles efficiently
explosion_particles.one_shot = true
explosion_particles.emitting = true

# ⚠️ CAUTION: Use CPUParticles2D only for <10 particles or when needing precise control
var trail_particles := CPUParticles2D.new()
trail_particles.amount = 5  # Small count

# ❌ BAD: CPUParticles2D with high counts
var particles := CPUParticles2D.new()
particles.amount = 500  # Will destroy framerate!
```

### Particle Pooling
```gdscript
# ✅ GOOD: Pool particle systems
func spawn_explosion(pos: Vector2) -> void:
    var particles := _particle_pool.acquire()
    if particles == null:
        return  # Pool exhausted, skip effect
    
    particles.global_position = pos
    particles.emitting = true
    particles.one_shot = true
    
    # Return to pool when finished
    await get_tree().create_timer(particles.lifetime).timeout
    if is_instance_valid(particles):
        particles.emitting = false
        _particle_pool.release(particles)
```

## Profiling and Diagnostics

### Performance Monitoring
```gdscript
# ✅ GOOD: Track frame times and entity counts
var _frame_times: Array[float] = []
var _frame_time_index: int = 0
const FRAME_TIME_SAMPLES: int = 60

func _process(delta: float) -> void:
    # Record frame time
    _frame_times[_frame_time_index] = delta
    _frame_time_index = (_frame_time_index + 1) % FRAME_TIME_SAMPLES
    
    # Calculate average FPS
    var avg_delta := 0.0
    for ft in _frame_times:
        avg_delta += ft
    avg_delta /= float(_frame_times.size())
    var avg_fps := 1.0 / avg_delta
    
    if avg_fps < 55.0:
        push_warning("[Performance] FPS below target: %.1f" % avg_fps)

func get_performance_stats() -> Dictionary:
    return {
        "active_bullets": EntityFactory.get_active_count("bullet"),
        "active_enemies": EntityFactory.get_active_count("enemy"),
        "active_particles": EntityFactory.get_active_count("particle"),
        "fps": Engine.get_frames_per_second(),
        "physics_time": Performance.get_monitor(Performance.TIME_PHYSICS_PROCESS),
        "process_time": Performance.get_monitor(Performance.TIME_PROCESS),
    }
```

### Debug Visualization (Gated)
```gdscript
# ✅ GOOD: Gate expensive debug rendering
const DEBUG_DRAW: bool = false

func _draw() -> void:
    if not DEBUG_DRAW:
        return
    
    # Expensive debug drawing only when enabled
    for bullet in _active_bullets:
        draw_circle(bullet.position, 3.0, Color.RED)
        draw_line(bullet.position, bullet.position + bullet.velocity, Color.YELLOW)

# ❌ BAD: Always-on debug drawing
