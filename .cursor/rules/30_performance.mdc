## Common Performance Pitfalls

### 1. String Concatenation in Loops
```gdscript
# ❌ BAD: String allocation every iteration
func build_debug_string() -> String:
    var result := ""
    for i in range(1000):
        result += str(i) + " "  # Allocates new string each time!
    return result

# ✅ GOOD: Use Array.join()
func build_debug_string() -> String:
    var parts: Array[String] = []
    for i in range(1000):
        parts.append(str(i))
    return " ".join(parts)
```

### 2. Unnecessary Collision Layer Checks
```gdscript
# ❌ BAD: Checking every object for collision
func _physics_process(delta: float) -> void:
    for body in get_tree().get_nodes_in_group("all_objects"):
        if body.overlaps(self):
            _handle_collision(body)

# ✅ GOOD: Use collision layers and Area2D signals
func _ready() -> void:
    collision_layer = 1  # Player bullet layer
    collision_mask = 2   # Enemy layer only
    body_entered.connect(_on_body_entered)

func _on_body_entered(body: Node2D) -> void:
    # Only called for relevant collisions
    _handle_collision(body)
```

### 3. Excessive Signal Emissions
```gdscript
# ❌ BAD: Emitting signals every frame
func _process(delta: float) -> void:
    position_changed.emit(position)  # 60 times per second!

# ✅ GOOD: Emit only on significant changes
var _last_emitted_pos: Vector2 = Vector2.ZERO
const EMIT_THRESHOLD: float = 5.0

func _process(delta: float) -> void:
    if position.distance_squared_to(_last_emitted_pos) > EMIT_THRESHOLD * EMIT_THRESHOLD:
        position_changed.emit(position)
        _last_emitted_pos = position
```

## Summary

Performance is CRITICAL for bullet-hell gameplay. Always profile with realistic load (500+ bullets), use object pooling religiously, cache everything, and degrade gracefully under stress. When in doubt, measure first, optimize second.
