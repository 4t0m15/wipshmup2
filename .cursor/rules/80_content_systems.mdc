## Serialization Safety

### General Principles
1. **Always provide defaults** for missing fields
2. **Validate and clamp** all numeric values
3. **Check types** before casting
4. **Log warnings** for malformed data
5. **Never crash** on bad data

### Safe Dictionary Access Pattern
```gdscript
# ✅ GOOD: Safe access with defaults
func parse_config(data: Dictionary) -> ConfigData:
    var config := ConfigData.new()
    
    config.setting_1 = data.get("setting_1", DEFAULT_SETTING_1)
    config.setting_2 = int(data.get("setting_2", DEFAULT_SETTING_2))
    config.setting_3 = float(data.get("setting_3", DEFAULT_SETTING_3))
    
    # Array with type checking
    var array_data := data.get("items", [])
    if array_data is Array:
        for item in array_data:
            if item is String:
                config.items.append(item)
    
    return config

# ❌ BAD: Direct access (crashes on missing keys)
func parse_config(data: Dictionary) -> ConfigData:
    var config := ConfigData.new()
    config.setting_1 = data["setting_1"]  # CRASH if missing!
    config.setting_2 = data["setting_2"]
    return config
```

