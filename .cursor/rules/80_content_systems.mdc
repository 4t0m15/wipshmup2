## Boss Template System

### Boss Template Structure
```gdscript
class_name BossTemplate extends Resource

@export var boss_id: String = ""
@export var boss_name: String = "Unknown Boss"
@export var total_health: int = 1000
@export var warning_duration: float = 3.0
@export var defeat_score: int = 10000
@export var sprite_path: String = ""
@export var music_track: String = ""
@export var phases: Array[BossPhase] = []

class_name BossPhase extends Resource

@export var phase_number: int = 1
@export var phase_name: String = "Phase 1"
@export var health_threshold: float = 1.0  # 1.0 = start, 0.0 = death
@export var movement_pattern: String = "circle"
@export var attack_patterns: Array[String] = []
@export var attack_interval: float = 2.0
@export var speed_multiplier: float = 1.0
```

### Validation Rules
```gdscript
func validate_boss_template(template: BossTemplate) -> bool:
    var errors: Array[String] = []
    
    # Boss ID validation
    if template.boss_id.is_empty():
        errors.append("boss_id cannot be empty")
    
    # Health validation
    if template.total_health <= 0:
        errors.append("total_health must be positive (got: %d)" % template.total_health)
    
    if template.total_health < 1000:
        errors.append("total_health too low for boss (got: %d, min: 1000)" % template.total_health)
    
    # Score validation
    if template.defeat_score < 0:
        errors.append("defeat_score cannot be negative")
    
    # Warning duration validation
    if template.warning_duration < 0.0:
        errors.append("warning_duration cannot be negative")
    
    if template.warning_duration > 10.0:
        errors.append("warning_duration too long (got: %.1f, max: 10.0)" % template.warning_duration)
    
    # Phase validation
    if template.phases.is_empty():
        errors.append("Boss must have at least one phase")
    
    for phase in template.phases:
        var phase_errors := _validate_boss_phase(phase)
        errors.append_array(phase_errors)
    
    # Phase health threshold ordering
    if template.phases.size() > 1:
        var prev_threshold := 1.1  # Start above 1.0
        for phase in template.phases:
            if phase.health_threshold >= prev_threshold:
                errors.append("Phase %d threshold (%.2f) must be less than previous (%.2f)" % [
                    phase.phase_number,
                    phase.health_threshold,
                    prev_threshold
                ])
            prev_threshold = phase.health_threshold
    
    if not errors.is_empty():
        push_error("[BossTemplate:%s] Validation failed:\n  - %s" % [
            template.boss_id,
            "\n  - ".join(errors)
        ])
        return false
    
    return true

func _validate_boss_phase(phase: BossPhase) -> Array[String]:
    var errors: Array[String] = []
    
    if phase.phase_number <= 0:
        errors.append("Phase number must be positive (got: %d)" % phase.phase_number)
    
    if phase.phase_name.is_empty():
        errors.append("Phase %d name cannot be empty" % phase.phase_number)
    
    if phase.health_threshold < 0.0 or phase.health_threshold > 1.0:
        errors.append("Phase %d threshold must be 0.0-1.0 (got: %.2f)" % [
            phase.phase_number,
            phase.health_threshold
        ])
    
    if phase.movement_pattern.is_empty():
        errors.append("Phase %d movement_pattern cannot be empty" % phase.phase_number)
    
    if phase.attack_patterns.is_empty():
        errors.append("Phase %d must have at least one attack pattern" % phase.phase_number)
    
    if phase.attack_interval < 0.5:
        errors.append("Phase %d attack_interval too low (got: %.2f, min: 0.5)" % [
            phase.phase_number,
            phase.attack_interval
        ])
    
    if phase.speed_multiplier <= 0.0:
        errors.append("Phase %d speed_multiplier must be positive (got: %.2f)" % [
            phase.phase_number,
            phase.speed_multiplier
        ])
    
    return errors
```

