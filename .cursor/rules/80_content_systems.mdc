## Stage Template System

### Stage Definition Structure
```gdscript
class_name StageDefinition extends Resource

@export var stage_number: int = 1
@export var stage_name: String = "Stage 1"
@export var background_id: String = "space_01"
@export var music_track: String = "stage_01"
@export var scroll_speed: float = 30.0
@export var boss_id: String = ""  # Empty = no boss
@export var waves: Array[WaveDefinition] = []

class_name WaveDefinition extends Resource

@export var wave_number: int = 1
@export var wave_duration: float = 30.0
@export var spawn_entries: Array[SpawnEntry] = []

class_name SpawnEntry extends Resource

@export var template_id: String = ""
@export var spawn_time: float = 0.0  # Seconds from wave start
@export var spawn_position: Vector2 = Vector2.ZERO
@export var formation: String = "single"
@export var formation_count: int = 1
@export var formation_spacing: float = 32.0
```

### Validation Rules
```gdscript
func validate_stage_definition(stage: StageDefinition) -> bool:
    var errors: Array[String] = []
    
    # Stage number validation
    if stage.stage_number <= 0:
        errors.append("stage_number must be positive (got: %d)" % stage.stage_number)
    
    # Stage name validation
    if stage.stage_name.is_empty():
        errors.append("stage_name cannot be empty")
    
    # Scroll speed validation
    if stage.scroll_speed < 0.0:
        errors.append("scroll_speed cannot be negative (got: %.2f)" % stage.scroll_speed)
    
    if stage.scroll_speed > 200.0:
        errors.append("scroll_speed suspiciously high (got: %.2f, expected <200)" % stage.scroll_speed)
    
    # Boss validation
    if not stage.boss_id.is_empty():
        if not BossTemplateManager.has_template(stage.boss_id):
            errors.append("Boss template not found: %s" % stage.boss_id)
    
    # Wave validation
    if stage.waves.is_empty():
        errors.append("Stage must have at least one wave")
    
    for wave in stage.waves:
        var wave_errors := _validate_wave_definition(wave)
        errors.append_array(wave_errors)
    
    if not errors.is_empty():
        push_error("[StageDefinition:%d] Validation failed:\n  - %s" % [
            stage.stage_number,
            "\n  - ".join(errors)
        ])
        return false
    
    return true

func _validate_wave_definition(wave: WaveDefinition) -> Array[String]:
    var errors: Array[String] = []
    
    if wave.wave_number <= 0:
        errors.append("Wave number must be positive")
    
    if wave.wave_duration <= 0.0:
        errors.append("Wave %d duration must be positive" % wave.wave_number)
    
    if wave.wave_duration > 300.0:
        errors.append("Wave %d duration suspiciously long (%.1fs)" % [
            wave.wave_number,
            wave.wave_duration
        ])
    
    if wave.spawn_entries.is_empty():
        errors.append("Wave %d has no spawn entries" % wave.wave_number)
    
    for entry in wave.spawn_entries:
        var entry_errors := _validate_spawn_entry(entry, wave.wave_number)
        errors.append_array(entry_errors)
    
    return errors

func _validate_spawn_entry(entry: SpawnEntry, wave_num: int) -> Array[String]:
    var errors: Array[String] = []
    
    if entry.template_id.is_empty():
        errors.append("Wave %d: Spawn entry has empty template_id" % wave_num)
    
    if not EnemyTemplateManager.has_template(entry.template_id):
        errors.append("Wave %d: Enemy template not found: %s" % [wave_num, entry.template_id])
    
    if entry.spawn_time < 0.0:
        errors.append("Wave %d: Spawn time cannot be negative (%.2fs)" % [
            wave_num,
            entry.spawn_time
        ])
    
    # Formation validation
    var valid_formations := ["single", "line", "v_formation", "circle", "grid"]
    if not entry.formation in valid_formations:
        errors.append("Wave %d: Unknown formation '%s' (valid: %s)" % [
            wave_num,
            entry.formation,
            str(valid_formations)
        ])
    
    if entry.formation_count <= 0:
        errors.append("Wave %d: formation_count must be positive (got: %d)" % [
            wave_num,
            entry.formation_count
        ])
    
    if entry.formation_count > 50:
        errors.append("Wave %d: formation_count suspiciously high (%d, expected <50)" % [
            wave_num,
            entry.formation_count
        ])
    
    return errors
```

