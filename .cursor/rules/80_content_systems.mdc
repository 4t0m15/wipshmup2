## Difficulty Scaling System

### Rank Pressure Configuration
```ini
; File: wipshmup2/config/difficulty.cfg

[rank_system]
time_pressure_per_second = 0.01  ; Rank increase per second
power_pressure_per_level = 0.5   ; Rank increase per power level
death_penalty = -0.5             ; Rank decrease on death
min_rank = 0.0
max_rank = 10.0

[difficulty_scaling]
enemy_health_per_rank = 1.1      ; Multiplier per rank point
enemy_speed_per_rank = 1.05      ; Multiplier per rank point
bullet_speed_per_rank = 1.03     ; Multiplier per rank point
spawn_rate_per_rank = 1.08       ; Multiplier per rank point
```

### Loading and Validation
```gdscript
func load_difficulty_config(file_path: String) -> Dictionary:
    var config := ConfigFile.new()
    var err := config.load(file_path)
    
    if err != OK:
        push_error("[DifficultyManager] Cannot load config: %s (error: %d)" % [file_path, err])
        return _get_default_difficulty_config()
    
    var difficulty_config := {
        "time_pressure": config.get_value("rank_system", "time_pressure_per_second", 0.01),
        "power_pressure": config.get_value("rank_system", "power_pressure_per_level", 0.5),
        "death_penalty": config.get_value("rank_system", "death_penalty", -0.5),
        "min_rank": config.get_value("rank_system", "min_rank", 0.0),
        "max_rank": config.get_value("rank_system", "max_rank", 10.0),
        "health_scaling": config.get_value("difficulty_scaling", "enemy_health_per_rank", 1.1),
        "speed_scaling": config.get_value("difficulty_scaling", "enemy_speed_per_rank", 1.05),
        "bullet_scaling": config.get_value("difficulty_scaling", "bullet_speed_per_rank", 1.03),
        "spawn_scaling": config.get_value("difficulty_scaling", "spawn_rate_per_rank", 1.08),
    }
    
    # Validate ranges
    difficulty_config = _validate_difficulty_config(difficulty_config)
    return difficulty_config

func _validate_difficulty_config(config: Dictionary) -> Dictionary:
    # Clamp to safe ranges
    config["time_pressure"] = clampf(config["time_pressure"], 0.0, 0.1)
    config["power_pressure"] = clampf(config["power_pressure"], 0.0, 2.0)
    config["death_penalty"] = clampf(config["death_penalty"], -2.0, 0.0)
    config["min_rank"] = clampf(config["min_rank"], 0.0, 5.0)
    config["max_rank"] = clampf(config["max_rank"], config["min_rank"], 20.0)
    config["health_scaling"] = clampf(config["health_scaling"], 1.0, 2.0)
    config["speed_scaling"] = clampf(config["speed_scaling"], 1.0, 2.0)
    config["bullet_scaling"] = clampf(config["bullet_scaling"], 1.0, 2.0)
    config["spawn_scaling"] = clampf(config["spawn_scaling"], 1.0, 3.0)
    
    return config
```

