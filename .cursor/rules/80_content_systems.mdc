# Data-Driven Content Philosophy

## Core Principle
**Gameplay logic is generic; specific behavior comes from data.**

This separation allows:
- Balance changes without code modifications
- Rapid iteration on enemy/boss designs
- Easy difficulty scaling
- Community modding potential

---

## Enemy Template System

### Template Structure
```gdscript
class_name EnemyTemplate extends Resource

@export var template_id: String = ""
@export var enemy_name: String = "Unknown"
@export var max_health: int = 10
@export var score_value: int = 100
@export var movement_type: String = "straight"
@export var movement_speed: float = 100.0
@export var attack_pattern: String = "none"
@export var attack_cooldown: float = 2.0
@export var sprite_path: String = ""
@export var collision_radius: float = 8.0
@export var item_drop_chance: float = 0.1
@export var item_drop_types: Array[String] = []
```

### Validation Rules

#### Required Fields
```gdscript
func validate_enemy_template(template: EnemyTemplate) -> bool:
    var errors: Array[String] = []
    
    # template_id is mandatory and unique
    if template.template_id.is_empty():
        errors.append("template_id cannot be empty")
    
    if template.template_id.contains(" "):
        errors.append("template_id cannot contain spaces (use underscores)")
    
    # enemy_name for display
    if template.enemy_name.is_empty():
        errors.append("enemy_name cannot be empty")
    
    # Health validation
    if template.max_health <= 0:
        errors.append("max_health must be positive (got: %d)" % template.max_health)
    
    if template.max_health > 10000:
        errors.append("max_health suspiciously high (got: %d, expected <10000)" % template.max_health)
    
    # Score validation
    if template.score_value < 0:
        errors.append("score_value cannot be negative (got: %d)" % template.score_value)
    
    # Movement validation
    if template.movement_type.is_empty():
        errors.append("movement_type cannot be empty")
    
    var valid_movements := ["straight", "zigzag", "circle", "homing", "spiral"]
    if not template.movement_type in valid_movements:
        errors.append("Unknown movement_type '%s' (valid: %s)" % [
            template.movement_type,
            str(valid_movements)
        ])
    
    if template.movement_speed <= 0.0:
        errors.append("movement_speed must be positive (got: %.2f)" % template.movement_speed)
    
    if template.movement_speed > 500.0:
        errors.append("movement_speed suspiciously high (got: %.2f, expected <500)" % template.movement_speed)
    
    # Attack validation
    var valid_attacks := ["none", "single_shot", "spread_shot", "aimed_shot", "burst_fire"]
    if not template.attack_pattern in valid_attacks:
        errors.append("Unknown attack_pattern '%s' (valid: %s)" % [
            template.attack_pattern,
            str(valid_attacks)
        ])
    
    if template.attack_cooldown < 0.5:
        errors.append("attack_cooldown too low (got: %.2f, min: 0.5)" % template.attack_cooldown)
    
    # Collision validation
    if template.collision_radius <= 0.0:
        errors.append("collision_radius must be positive (got: %.2f)" % template.collision_radius)
    
    if template.collision_radius > 50.0:
        errors.append("collision_radius suspiciously large (got: %.2f, expected <50)" % template.collision_radius)
    
    # Item drop validation
    if template.item_drop_chance < 0.0 or template.item_drop_chance > 1.0:
        errors.append("item_drop_chance must be 0.0-1.0 (got: %.2f)" % template.item_drop_chance)
    
    # Log errors
    if not errors.is_empty():
        push_error("[EnemyTemplate:%s] Validation failed:\n  - %s" % [
            template.template_id,
            "\n  - ".join(errors)
        ])
        return false
    
    return true
```

#### Safe Defaults
```gdscript
func apply_safe_defaults(template: EnemyTemplate) -> EnemyTemplate:
    var safe := template.duplicate()
    
    # Clamp values to safe ranges
    safe.max_health = clampi(safe.max_health, 1, 10000)
    safe.score_value = maxi(0, safe.score_value)
    safe.movement_speed = clampf(safe.movement_speed, 10.0, 500.0)
    safe.attack_cooldown = maxf(safe.attack_cooldown, 0.5)
    safe.collision_radius = clampf(safe.collision_radius, 2.0, 50.0)
    safe.item_drop_chance = clampf(safe.item_drop_chance, 0.0, 1.0)
    
    # Provide defaults for empty strings
    if safe.movement_type.is_empty():
        safe.movement_type = "straight"
        push_warning("[EnemyTemplate:%s] movement_type empty, defaulting to 'straight'" % safe.template_id)
    
    if safe.attack_pattern.is_empty():
        safe.attack_pattern = "none"
    
    if safe.sprite_path.is_empty():
        safe.sprite_path = "res://assets/enemies/default.png"
        push_warning("[EnemyTemplate:%s] sprite_path empty, using default" % safe.template_id)
    
    return safe
```

