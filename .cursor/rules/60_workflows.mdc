## Workflow 3: Add a New Boss

### Prerequisites
- Boss sprite asset (recommend 64x64 or larger)
- Boss phases designed (HP thresholds, attack patterns)
- Attack patterns implemented as behaviors
- Music track ready (optional)

### Step-by-Step Procedure

#### 1. Create BossTemplate (15 minutes)
```gdscript
# File: wipshmup2/scripts/autoload/boss_template_manager.gd

func _create_boss_crystal_golem() -> BossTemplate:
    var boss := BossTemplate.new()
    boss.boss_id = "boss_crystal_golem"
    boss.boss_name = "Crystal Golem"
    boss.total_health = 3000
    boss.warning_duration = 4.0
    boss.defeat_score = 50000
    boss.music_track = "boss_crystal_theme"
    
    # Phase 1: 100% - 66% HP
    var phase_1 := BossPhase.new()
    phase_1.phase_number = 1
    phase_1.phase_name = "Awakening"
    phase_1.health_threshold = 1.0
    phase_1.movement_pattern = "figure_eight"
    phase_1.attack_patterns = ["spread_shot", "aimed_burst"]
    phase_1.attack_interval = 2.5
    phase_1.speed_multiplier = 1.0
    
    # Phase 2: 66% - 33% HP
    var phase_2 := BossPhase.new()
    phase_2.phase_number = 2
    phase_2.phase_name = "Enraged"
    phase_2.health_threshold = 0.66
    phase_2.movement_pattern = "aggressive_dash"
    phase_2.attack_patterns = ["spread_shot", "aimed_burst", "laser_sweep"]
    phase_2.attack_interval = 1.8
    phase_2.speed_multiplier = 1.3
    
    # Phase 3: 33% - 0% HP
    var phase_3 := BossPhase.new()
    phase_3.phase_number = 3
    phase_3.phase_name = "Desperation"
    phase_3.health_threshold = 0.33
    phase_3.movement_pattern = "erratic_teleport"
    phase_3.attack_patterns = ["bullet_hell_spiral", "screen_clear_beam"]
    phase_3.attack_interval = 1.2
    phase_3.speed_multiplier = 1.5
    
    boss.phases = [phase_1, phase_2, phase_3]
    return boss
```

#### 2. Implement Boss Scene (20 minutes)
```gdscript
# File: wipshmup2/scripts/boss/boss_controller.gd

class_name BossController extends Node2D

signal phase_changed(phase_number: int)
signal defeated(boss_id: String, time: float, no_miss: bool)

@export var boss_id: String = ""

var current_phase: int = 0
var health: int = 0
var max_health: int = 0
var spawn_time: float = 0.0
var _template: BossTemplate = null
var _movement_behavior: Node = null
var _attack_behaviors: Array[Node] = []

func _ready() -> void:
    _template = BossTemplateManager.get_template(boss_id)
    if _template == null:
        push_error("[Boss] Template '%s' not found" % boss_id)
        queue_free()
        return
    
    max_health = _template.total_health
    health = max_health
    spawn_time = Time.get_ticks_msec() / 1000.0
    
    # Start with phase 1
    _enter_phase(_template.phases[0])
    
    # Connect to EventBus
    EventBus.boss_spawned.emit(self, boss_id)

func take_damage(amount: int) -> void:
    if health <= 0:
        return
    
    health = maxi(0, health - amount)
    
    # Check for phase transitions
    var health_percent := float(health) / float(max_health)
    _check_phase_transition(health_percent)
    
    if health <= 0:
        _on_defeated()

func _check_phase_transition(health_percent: float) -> void:
    for phase in _template.phases:
        if (
            phase.phase_number > current_phase
            and health_percent <= phase.health_threshold
        ):
            _enter_phase(phase)
            break

func _enter_phase(phase: BossPhase) -> void:
    current_phase = phase.phase_number
    
    # Clear old behaviors
    _clear_behaviors()
    
    # Add movement behavior (NOT deferred - boss already in tree)
    _movement_behavior = _create_movement_behavior(phase.movement_pattern)
    if _movement_behavior != null:
        add_child(_movement_behavior)
    
    # Add attack behaviors
    for attack_id in phase.attack_patterns:
        var attack_behavior := _create_attack_behavior(attack_id)
        if attack_behavior != null:
            add_child(attack_behavior)
            _attack_behaviors.append(attack_behavior)
    
    # Emit phase change event
    EventBus.boss_phase_changed.emit(boss_id, phase.phase_number, phase.phase_name)
    phase_changed.emit(phase.phase_number)

func _clear_behaviors() -> void:
    if is_instance_valid(_movement_behavior):
        _movement_behavior.queue_free()
        _movement_behavior = null
    
    for behavior in _attack_behaviors:
        if is_instance_valid(behavior):
            behavior.queue_free()
    _attack_behaviors.clear()

func _on_defeated() -> void:
    var completion_time := (Time.get_ticks_msec() / 1000.0) - spawn_time
    var no_miss := true  # TODO: Track if player took damage during fight
    
    EventBus.boss_defeated.emit(boss_id, completion_time, no_miss)
    defeated.emit(boss_id, completion_time, no_miss)
    
    GameState.add_score(_template.defeat_score)
    call_deferred("queue_free")
```

#### 3. Implement Boss Attack Patterns (30-60 minutes)
```gdscript
# File: wipshmup2/scripts/boss/attacks/spread_shot_attack.gd

class_name BossSpreadShotAttack extends AttackBehavior

@export var bullet_count: int = 12
@export var bullet_speed: float = 120.0
@export var spread_angle: float = 360.0
@export var cooldown: float = 2.0

var _cooldown_timer: float = 0.0

func _process(delta: float) -> void:
    _cooldown_timer -= delta
    if _cooldown_timer <= 0.0:
        _execute_attack()
        _cooldown_timer = cooldown

func _execute_attack() -> void:
    var parent := get_parent() as Node2D
    if not is_instance_valid(parent):
        return
    
    var angle_step := deg_to_rad(spread_angle / float(bullet_count))
    var start_angle := -deg_to_rad(spread_angle * 0.5)
    
    for i in range(bullet_count):
        var angle := start_angle + angle_step * i
        var direction := Vector2.RIGHT.rotated(angle)
        
        var bullet := EntityFactory.spawn_bullet(
            "enemy_boss_bullet",
            parent.global_position,
            direction
        )
        
        if bullet != null:
            bullet.speed = bullet_speed
```

#### 4. Integrate with StageController (10 minutes)
```gdscript
# File: wipshmup2/scripts/controllers/stage_controller.gd

func _start_boss_phase() -> void:
    if _current_stage.boss_id.is_empty():
        _on_stage_complete()
        return
    
    # Show boss warning
    EventBus.boss_warning.emit(_current_stage.boss_id, 4.0)
    await get_tree().create_timer(4.0).timeout
    
    if not is_instance_valid(self):
        return
    
    # Spawn boss
    var boss := EntityFactory.spawn_boss(_current_stage.boss_id, Vector2(160, 40))
    if boss == null:
        push_error("[StageController] Failed to spawn boss '%s'" % _current_stage.boss_id)
        _on_stage_complete()
        return
    
    # Wait for boss defeat
    GameState.is_boss_active = true
    await boss.defeated
    GameState.is_boss_active = false
    
    _on_stage_complete()
```

#### 5. Test Boss Fight (30 minutes)
1. Play through stage to reach boss
2. Test each phase:
   - [ ] Phase 1 starts correctly
   - [ ] Attack patterns execute as designed
   - [ ] Movement pattern works
   - [ ] Phase 2 triggers at 66% HP
   - [ ] Phase 3 triggers at 33% HP
   - [ ] Defeat triggers at 0 HP
   - [ ] Score awarded correctly
   - [ ] Stage progression continues
3. Test edge cases:
   - [ ] Boss dies in one hit (debug mode)
   - [ ] Player dies during fight
   - [ ] Player bombs during fight
4. Check performance (should stay at 60 FPS)

**Total Time**: ~2-3 hours for complete new boss

