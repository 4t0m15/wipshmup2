## Workflow 6: Add a Pooled Entity Type

### Step-by-Step Procedure

#### 1. Define Pool Configuration (5 minutes)
```gdscript
# File: wipshmup2/scripts/core/entity_factory.gd

const POOL_LIMITS: Dictionary = {
    # ... existing pools ...
    "new_entity_type": 50,  # Max 50 instances
}
```

#### 2. Implement Entity with Pool-Safe Reset (30 minutes)
```gdscript
# File: wipshmup2/scripts/entities/new_entity.gd

class_name NewEntity extends Node2D

@export var max_health: int = 100
var health: int = 100
var velocity: Vector2 = Vector2.ZERO
var _target: Node2D = null

func activate(spawn_position: Vector2, initial_velocity: Vector2) -> void:
    global_position = spawn_position
    velocity = initial_velocity
    health = max_health
    visible = true
    process_mode = Node.PROCESS_MODE_INHERIT
    set_physics_process(true)

func reset_for_pool() -> void:
    # 1. Disconnect signals
    for connection in get_incoming_connections():
        var sig: Signal = connection.signal
        if sig.is_connected(connection.callable):
            sig.disconnect(connection.callable)
    
    # 2. Reset transform
    global_position = Vector2.ZERO
    rotation = 0.0
    scale = Vector2.ONE
    
    # 3. Reset state
    health = max_health
    velocity = Vector2.ZERO
    _target = null
    
    # 4. Reset visual
    modulate = Color.WHITE
    visible = false
    
    # 5. Disable processing
    process_mode = Node.PROCESS_MODE_DISABLED
    set_physics_process(false)
    set_process(false)

func return_to_pool() -> void:
    EntityFactory.return_to_pool(self, "new_entity_type")
```

#### 3. Add Spawn Method to EntityFactory (10 minutes)
```gdscript
# File: wipshmup2/scripts/core/entity_factory.gd

func spawn_new_entity(position: Vector2, velocity: Vector2) -> NewEntity:
    var entity := _acquire_from_pool("new_entity_type") as NewEntity
    if entity == null:
        push_warning("[EntityFactory] Pool 'new_entity_type' exhausted")
        return null
    
    entity.activate(position, velocity)
    return entity
```

#### 4. Test Pool Lifecycle (15 minutes)
```gdscript
# Test script:
func _test_pooling() -> void:
