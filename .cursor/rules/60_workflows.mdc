# Development Workflows

## Workflow 1: Add a New Enemy Type

### Prerequisites
- Enemy sprite asset ready (PNG, recommended 32x32 or 64x64)
- Design decided: HP, speed, attack pattern, score value
- Movement behavior defined

### Step-by-Step Procedure

#### 1. Create Enemy Template (5 minutes)
```gdscript
# File: wipshmup2/scripts/autoload/enemy_template_manager.gd

# In EnemyTemplateManager._ready() or separate initialization method:
func _create_new_enemy_templates() -> void:
    var new_enemy := EnemyTemplate.new()
    new_enemy.template_id = "shooter_fast_01"
    new_enemy.enemy_name = "Fast Shooter"
    new_enemy.max_health = 30
    new_enemy.score_value = 300
    new_enemy.movement_type = "straight"
    new_enemy.movement_speed = 120.0
    new_enemy.attack_pattern = "aimed_shot"
    new_enemy.attack_cooldown = 1.5
    new_enemy.collision_radius = 12.0
    new_enemy.item_drop_chance = 0.15
    new_enemy.item_drop_types = ["power", "score"]
    
    register_template(new_enemy)
```

**Alternatively**, add to `wipshmup2/config/enemies.json`:
```json
{
    "template_id": "shooter_fast_01",
    "enemy_name": "Fast Shooter",
    "max_health": 30,
    "score_value": 300,
    "movement_type": "straight",
    "movement_speed": 120.0,
    "attack_pattern": "aimed_shot",
    "attack_cooldown": 1.5,
    "collision_radius": 12.0,
    "item_drop_chance": 0.15,
    "item_drop_types": ["power", "score"]
}
```

#### 2. Implement Movement Behavior (if new) (15 minutes)
```gdscript
# File: wipshmup2/scripts/components/movement_straight.gd

class_name StraightMovement extends MovementBehavior

@export var direction: Vector2 = Vector2.DOWN
@export var speed: float = 100.0

func _physics_process(delta: float) -> void:
    var parent := get_parent() as Node2D
    if not is_instance_valid(parent):
        return
    
    parent.global_position += direction.normalized() * speed * delta
```

#### 3. Implement Attack Behavior (if new) (20 minutes)
```gdscript
# File: wipshmup2/scripts/components/attack_aimed_shot.gd

class_name AimedShotAttack extends AttackBehavior

@export var bullet_type: String = "enemy_basic"
@export var bullet_speed: float = 150.0
@export var cooldown: float = 2.0

var _cooldown_timer: float = 0.0
var _cached_player: Player = null

func _process(delta: float) -> void:
    _cooldown_timer -= delta
    
    if _cooldown_timer <= 0.0:
        _execute_attack()
        _cooldown_timer = cooldown

func _execute_attack() -> void:
    var parent := get_parent() as Node2D
    if not is_instance_valid(parent):
        return
    
    # Find player
    if not is_instance_valid(_cached_player):
        _cached_player = get_tree().get_first_node_in_group("player") as Player
    
    if not is_instance_valid(_cached_player):
        return
    
    # Calculate direction to player
    var direction := (
        _cached_player.global_position - parent.global_position
    ).normalized()
    
    # Spawn bullet via EntityFactory (pooled)
    var bullet := EntityFactory.spawn_bullet(
        bullet_type,
        parent.global_position,
        direction
    )
    
    if bullet != null:
        bullet.speed = bullet_speed
        # Emit event for audio/visual feedback
        EventBus.bullet_fired.emit(bullet, parent, bullet_type)
```

#### 4. Register in EntityFactory Pool (5 minutes)
```gdscript
# File: wipshmup2/scripts/core/entity_factory.gd

# Add to pool configuration:
const POOL_LIMITS: Dictionary = {
    # ... existing pools ...
    "enemy_shooter_fast": 20,  # New enemy pool
}

# EntityFactory will automatically create pool on startup
```

#### 5. Add to Wave Definition (10 minutes)
```gdscript
# File: wipshmup2/config/stages.json

# In appropriate stage's wave definition:
{
    "wave_number": 3,
    "spawn_entries": [
        {
            "template_id": "shooter_fast_01",
            "spawn_time": 5.0,
            "spawn_position": {"x": 160, "y": -20},
            "formation": "line",
            "formation_count": 5,
            "formation_spacing": 40.0
        }
    ]
}
```

#### 6. Test and Validate (15 minutes)
1. Run game in debug mode
2. Navigate to wave with new enemy
3. Verify:
   - [ ] Enemy spawns correctly
   - [ ] Movement pattern works as expected
   - [ ] Attack pattern functions (bullets spawn, aim correctly)
   - [ ] Taking damage decreases health
   - [ ] Death triggers correctly
   - [ ] Score awarded on defeat
   - [ ] Item drops work (if configured)
   - [ ] Returns to pool correctly (check with multiple spawns)
   - [ ] No errors in output console

#### 7. Performance Check (5 minutes)
- Spawn 20+ of the new enemy simultaneously
- Verify frame rate stays at 60 FPS
- Check Output console for rate limit warnings
- Adjust pool size if needed

**Total Time**: ~75 minutes for complete new enemy type

