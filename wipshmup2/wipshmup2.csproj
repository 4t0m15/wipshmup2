<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Prevent duplicate assembly attributes generated by both the SDK and Godot tooling -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Disable implicit usings to avoid ambiguous 'Dictionary' between Godot.Collections and System.Collections.Generic -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Prevent duplicate TargetFrameworkAttribute -->
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>
</Project>