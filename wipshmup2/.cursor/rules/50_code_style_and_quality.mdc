## Type Annotations (Mandatory)

### Variable Typing
```csharp
// ✅ GOOD: Explicit types everywhere
public int PlayerScore { get; set; } = 0;
public float MovementSpeed { get; set; } = 150.0f;
public string EnemyName { get; set; } = "Popcorn";
public bool IsActive { get; set; } = true;
public Vector2 PositionOffset { get; set; } = Vector2.Zero;
public List<Enemy> Enemies { get; set; } = new();
public Dictionary<int, int> HealthMap { get; set; } = new();

// ✅ GOOD: Type inference with var (when obvious)
var enemy = new Enemy();
var texture = GD.Load<Texture2D>("res://assets/enemy.png") as Texture2D;

// ❌ BAD: No types (object)
var score = 0; // Could be int or float?
var enemies = new List<object>(); // List of what?
var data = new Dictionary<object, object>(); // Dictionary with what keys/values?
```

### Function Typing
```csharp
// ✅ GOOD: Fully typed function signatures
public int CalculateDamage(
    int baseDamage,
    float multiplier,
    bool isCritical
)
{
    float finalDamage = baseDamage * multiplier;
    if (isCritical)
    {
        finalDamage *= 2.0f;
    }
    return (int)finalDamage;
}

// ✅ GOOD: Void return type explicit
public void ApplyVisualEffect(string effectType, float duration)
{
    SpawnParticleEffect(effectType);
    // Implementation
}

// ❌ BAD: Missing types
public object CalculateDamage(object base, object mult, object crit)
{
    return base; // What type? What does this do?
}
```

## Comments and Documentation

### When to Comment
```csharp
// ✅ GOOD: Comment non-obvious logic and invariants
public void UpdateBulletTrajectory(double delta)
{
    // Homing bullets adjust direction gradually towards target
    if (BulletType == BulletType.Homing && _target != null && IsInstanceValid(_target))
    {
        var desiredDir = (_target.GlobalPosition - GlobalPosition).Normalized();
        // Lerp factor ensures smooth turning rather than instant snapping
        Direction = Direction.Lerp(desiredDir, HomingStrength * (float)delta);
    }
    
    Position += Direction * Speed * (float)delta;
}

// ✅ GOOD: Document complex algorithms
public float CalculateRankPressure()
{
    // Rank pressure system from Cho Ren Sha 68k:
    // - Increases over time (time pressure)
    // - Increases with player power (power pressure)
    // - Decreases when taking damage (death penalty)
    // - Capped at 10.0 for max difficulty
    float timePressure = Mathf.Min(_playTime / 60.0f, 3.0f);
    float powerPressure = GameState.PowerLevel * 0.5f;
    float deathPenalty = GameState.DeathCount * -0.2f;
    return Mathf.Clamp(timePressure + powerPressure + deathPenalty, 0.0f, 10.0f);
}

// ❌ BAD: Obvious comments (noise)
public void SetHealth(int value)
{
    Health = value; // Set health to value
}

// ❌ BAD: Outdated comments
public void SpawnEnemy()
{
    // TODO: Add pooling later
    var enemy = EntityFactory.SpawnEnemy(...); // Already using pooling!
}
```

