## Control Flow Style

### Early Returns (Preferred)
```csharp
// ✅ GOOD: Guard clauses and early returns
public void AttackTarget(Node2D target)
{
    if (target == null || !IsInstanceValid(target))
        return;
    
    if (AttackCooldown > 0.0f)
        return;
    
    if (!IsInAttackRange(target))
        return;
    
    // Main logic here (not nested)
    FireBulletAt(target);
    AttackCooldown = AttackCooldownDuration;
}

// ❌ BAD: Deep nesting
public void AttackTarget(Node2D target)
{
    if (target != null && IsInstanceValid(target))
    {
        if (AttackCooldown <= 0.0f)
        {
            if (IsInAttackRange(target))
            {
                FireBulletAt(target);
                AttackCooldown = AttackCooldownDuration;
            }
        }
    }
}
```

### Ternary Operator (Use Sparingly)
```csharp
// ✅ GOOD: Simple ternary for assignment
var damageMultiplier = isCriticalHit ? 2.0f : 1.0f;
var color = isPlayerBullet ? Colors.Cyan : Colors.Red;

// ⚠️ ACCEPTABLE: One-level nested ternary (max)
var priority = isBoss ? 100 : (isElite ? 50 : 10);

// ❌ BAD: Complex or deeply nested ternaries
var result = isBoss ? (isEnraged ? 200 : 100) : (isElite ? (isDamaged ? 30 : 50) : 10);

// ✅ BETTER: Use if-else for complex logic
int result;
if (isBoss)
{
    result = isEnraged ? 200 : 100;
}
else if (isElite)
{
    result = isDamaged ? 30 : 50;
}
else
{
    result = 10;
}
```

### Switch Statements
```csharp
// ✅ GOOD: Switch for multiple discrete cases
public void HandleEnemyState(State state)
{
    switch (state)
    {
        case State.Idle:
            IdleBehavior();
            break;
        case State.Moving:
            MovementBehavior();
            break;
        case State.Attacking:
            AttackBehavior();
            break;
        case State.Dying:
            DeathBehavior();
            break;
        default:
            GD.PushError($"[Enemy] Unknown state: {state}");
            break;
    }
}

// ✅ GOOD: Switch expressions (C# 8+)
public Color GetEnemyColor(EnemyType enemyType)
{
    return enemyType switch
    {
        EnemyType.Popcorn or EnemyType.Fast => Colors.Green,
        EnemyType.Tank or EnemyType.Elite => Colors.Red,
        EnemyType.Boss => Colors.Purple,
        _ => Colors.White
    };
}
```

## Collection Formatting

### Array and List Formatting
```csharp
// ✅ GOOD: Short arrays on one line
var colors = new[] { Colors.Red, Colors.Green, Colors.Blue };
var numbers = new[] { 1, 2, 3, 4, 5 };

// ✅ GOOD: Long arrays on multiple lines (one per line)
var enemyTemplates = new[]
{
    "popcorn_01",
    "popcorn_02",
    "tank_01",
    "shooter_01",
    "elite_01",
};

// ✅ GOOD: Complex array elements on separate lines
var waveDefinitions = new[]
{
    new { Template = "popcorn_01", Count = 5, Formation = "line" },
    new { Template = "tank_01", Count = 2, Formation = "v_formation" },
};
```

### Dictionary Formatting
```csharp
// ✅ GOOD: Short dictionaries on one line
var stats = new Dictionary<string, int> { ["hp"] = 100, ["atk"] = 10, ["def"] = 5 };

// ✅ GOOD: Multi-line dictionaries (one key-value per line)
var enemyConfig = new Dictionary<string, object>
{
    ["template_id"] = "boss_01",
    ["max_health"] = 5000,
    ["damage"] = 50,
    ["movement_speed"] = 80.0f,
    ["attack_patterns"] = new[] { "spread_shot", "laser_beam" },
};

// ✅ GOOD: Typed dictionaries
var healthMap = new Dictionary<int, int>
{
    [1] = 100,
    [2] = 150,
    [3] = 200,
};

// ✅ GOOD: Trailing comma for multi-line (easier diffs)
var config = new Dictionary<string, object>
{
    ["setting_1"] = true,
    ["setting_2"] = false,
    ["setting_3"] = 42, // Trailing comma
};
```

