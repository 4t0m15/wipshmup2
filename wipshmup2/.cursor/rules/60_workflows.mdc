#### 2. Create Stage Controller
```csharp
// File: scripts/stages/StageController.cs
public partial class StageController : Node
{
    private StageDefinition _currentStage;
    private int _currentWaveIndex = 0;
    private float _stageStartTime;

    public override void _Ready()
    {
        // Connect to EventBus
        EventBus.WaveCleared += OnWaveCleared;
        EventBus.BossDefeated += OnBossDefeated;
    }

    public void StartStage(int stageNumber)
    {
        var stageDef = StageTemplateManager.GetStage(stageNumber);
        if (stageDef == null)
        {
            GD.PushError($"[StageController] Stage {stageNumber} not found");
            // Loop back to stage 1 if no more stages
            stageDef = StageTemplateManager.GetStage(1);
        }
        
        _currentStage = stageDef;
        _currentWaveIndex = 0;
        _stageStartTime = Time.GetTicksMsec() / 1000.0f;
        
        // Emit stage start event
        EventBus.EmitSignal(EventBus.SignalName.StageStarted, stageDef.StageNumber, stageDef.StageName);
        
        // Change background and music
        EventBus.EmitSignal(EventBus.SignalName.BackgroundChangeRequested, stageDef.BackgroundId, 1.0f);
        EventBus.EmitSignal(EventBus.SignalName.MusicChangeRequested, stageDef.MusicTrack, 2.0f);
        
        // Start first wave
        StartNextWave();
    }

    private void StartNextWave()
    {
        if (_currentWaveIndex >= _currentStage.Waves.Length)
        {
            StartBossPhase();
            return;
        }
        
        var waveDef = _currentStage.Waves[_currentWaveIndex];
        SpawnWaveEnemies(waveDef);
        
        EventBus.EmitSignal(EventBus.SignalName.WaveStarted, waveDef.WaveNumber, waveDef.SpawnEntries.Length);
    }

    private void SpawnWaveEnemies(WaveDefinition waveDef)
    {
        foreach (var spawnEntry in waveDef.SpawnEntries)
        {
            var timer = GetTree().CreateTimer(spawnEntry.SpawnTime);
            timer.Timeout += () => SpawnEnemyFormation(spawnEntry);
        }
    }

    private void SpawnEnemyFormation(SpawnEntry spawnEntry)
    {
        switch (spawnEntry.Formation)
        {
            case "single":
                SpawnSingleEnemy(spawnEntry);
                break;
            case "line":
                SpawnLineFormation(spawnEntry);
                break;
            case "v_formation":
                SpawnVFormation(spawnEntry);
                break;
            case "circle":
                SpawnCircleFormation(spawnEntry);
                break;
        }
    }

    private void SpawnSingleEnemy(SpawnEntry spawnEntry)
    {
        var enemy = EntityFactory.SpawnEnemy(spawnEntry.TemplateId, spawnEntry.SpawnPosition, Vector2.Down);
        if (enemy != null)
        {
            var template = EnemyTemplateManager.GetTemplate(spawnEntry.TemplateId);
            enemy.ApplyTemplate(template);
        }
    }

    private void SpawnLineFormation(SpawnEntry spawnEntry)
    {
        float startX = spawnEntry.SpawnPosition.X - (spawnEntry.FormationCount - 1) * spawnEntry.FormationSpacing / 2.0f;
        
        for (int i = 0; i < spawnEntry.FormationCount; i++)
        {
            Vector2 position = new(startX + i * spawnEntry.FormationSpacing, spawnEntry.SpawnPosition.Y);
            var enemy = EntityFactory.SpawnEnemy(spawnEntry.TemplateId, position, Vector2.Down);
            if (enemy != null)
            {
                var template = EnemyTemplateManager.GetTemplate(spawnEntry.TemplateId);
                enemy.ApplyTemplate(template);
            }
        }
    }

    private void SpawnVFormation(SpawnEntry spawnEntry)
    {
        // Implement V formation spawning
        float centerX = spawnEntry.SpawnPosition.X;
        float startY = spawnEntry.SpawnPosition.Y;
        
        for (int i = 0; i < spawnEntry.FormationCount; i++)
        {
            float offsetX = (i - spawnEntry.FormationCount / 2) * spawnEntry.FormationSpacing;
            Vector2 position = new(centerX + offsetX, startY + Mathf.Abs(offsetX) * 0.5f);
            var enemy = EntityFactory.SpawnEnemy(spawnEntry.TemplateId, position, Vector2.Down);
            if (enemy != null)
            {
                var template = EnemyTemplateManager.GetTemplate(spawnEntry.TemplateId);
                enemy.ApplyTemplate(template);
            }
        }
    }

    private void SpawnCircleFormation(SpawnEntry spawnEntry)
    {
        float radius = spawnEntry.FormationSpacing;
        float angleStep = Mathf.Tau / spawnEntry.FormationCount;
        
        for (int i = 0; i < spawnEntry.FormationCount; i++)
        {
            float angle = i * angleStep;
            Vector2 offset = new(Mathf.Cos(angle), Mathf.Sin(angle)) * radius;
            Vector2 position = spawnEntry.SpawnPosition + offset;
            var enemy = EntityFactory.SpawnEnemy(spawnEntry.TemplateId, position, Vector2.Down);
            if (enemy != null)
            {
                var template = EnemyTemplateManager.GetTemplate(spawnEntry.TemplateId);
                enemy.ApplyTemplate(template);
            }
        }
    }

    private void StartBossPhase()
    {
        if (string.IsNullOrEmpty(_currentStage.BossId))
        {
            // No boss, stage complete
            CompleteStage();
            return;
        }
        
        // Spawn boss
        var boss = EntityFactory.SpawnBoss(_currentStage.BossId, new Vector2(160, 50));
        if (boss != null)
        {
            var template = BossTemplateManager.GetTemplate(_currentStage.BossId);
            boss.ApplyTemplate(template);
        }
    }

    private void OnWaveCleared(int waveNumber, float time)
    {
        _currentWaveIndex++;
        StartNextWave();
    }

    private void OnBossDefeated(string bossId, float completionTime, bool noMiss)
    {
        CompleteStage();
    }

    private void CompleteStage()
    {
        float stageTime = Time.GetTicksMsec() / 1000.0f - _stageStartTime;
        EventBus.EmitSignal(EventBus.SignalName.StageCleared, _currentStage.StageNumber, stageTime, GameState.Score);
        
        // Start next stage after delay
        var timer = GetTree().CreateTimer(3.0);
        timer.Timeout += () => StartStage(_currentStage.StageNumber + 1);
    }
}
```

### Adding a New Bullet Type

#### 1. Create Bullet Class
```csharp
// File: scripts/bullet/Bullet.cs
public partial class Bullet : Area2D
{
    [Signal] public delegate void HitEventHandler(Bullet bullet, Node target, int damage);

    [ExportGroup("Stats")]
    [Export] public int Damage { get; set; } = 10;
    [Export] public float Speed { get; set; } = 200.0f;
    [Export] public float Lifetime { get; set; } = 5.0f;

    [ExportGroup("Behavior")]
    [Export] public bool IsPlayerBullet { get; set; } = false;
    [Export] public bool IsHoming { get; set; } = false;
    [Export] public float HomingStrength { get; set; } = 2.0f;

    private Vector2 _direction = Vector2.Down;
    private float _lifetimeTimer = 0.0f;
    private Node2D _target;

    public Vector2 Direction
    {
        get => _direction;
        set => _direction = value.Normalized();
    }

    public Node2D Target
    {
        get => _target;
        set => _target = value;
    }

    public override void _Ready()
    {
        // Setup collision
        var collision = new CollisionShape2D();
        var shape = new CircleShape2D();
        shape.Radius = 2.0f;
        collision.Shape = shape;
        AddChild(collision);
        
        // Connect signals
        BodyEntered += OnBodyEntered;
        
        // Add to appropriate group
        AddToGroup(IsPlayerBullet ? "player_bullets" : "enemy_bullets");
    }

    public override void _Process(double delta)
    {
        UpdateMovement(delta);
        UpdateLifetime(delta);
    }

    private void UpdateMovement(double delta)
    {
        if (IsHoming && _target != null && IsInstanceValid(_target))
        {
            // Homing behavior
            var desiredDir = (_target.GlobalPosition - GlobalPosition).Normalized();
            _direction = _direction.Lerp(desiredDir, HomingStrength * (float)delta);
        }
        
        Position += _direction * Speed * (float)delta;
    }

    private void UpdateLifetime(double delta)
    {
        _lifetimeTimer += (float)delta;
        if (_lifetimeTimer >= Lifetime)
        {
            ReturnToPool();
        }
    }

    private void OnBodyEntered(Node2D body)
    {
        if (IsPlayerBullet && body.IsInGroup("enemies"))
        {
            // Player bullet hit enemy
            EmitSignal(SignalName.Hit, this, body, Damage);
            ReturnToPool();
        }
        else if (!IsPlayerBullet && body.IsInGroup("player"))
        {
            // Enemy bullet hit player
            EmitSignal(SignalName.Hit, this, body, Damage);
            ReturnToPool();
        }
    }

    private void ReturnToPool()
    {
        var poolId = IsPlayerBullet ? "player_bullet_basic" : "enemy_bullet_basic";
        EntityFactory.ReturnToPool(this, poolId);
    }

    public void ResetForPool()
    {
        // Disconnect signals
        BodyEntered -= OnBodyEntered;
        
        // Reset state
        GlobalPosition = Vector2.Zero;
        _direction = Vector2.Down;
        _lifetimeTimer = 0.0f;
        _target = null;
        Visible = false;
        ProcessMode = ProcessModeEnum.Disabled;
    }
}
