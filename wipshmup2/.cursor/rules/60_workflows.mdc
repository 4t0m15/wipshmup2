// File: scripts/enemy/Enemy.cs
public partial class Enemy : Area2D
{
    [Signal] public delegate void HealthChangedEventHandler(int newHealth, int oldHealth);
    [Signal] public delegate void DefeatedEventHandler(int enemyId, Vector2 position, int scoreValue);

    [ExportGroup("Stats")]
    [Export] public int MaxHealth { get; set; } = 100;
    [Export] public int ScoreValue { get; set; } = 100;

    [ExportGroup("Behavior")]
    [Export] public string MovementPattern { get; set; } = "straight";
    [Export] public string AttackPattern { get; set; } = "none";
    [Export] public float AttackCooldown { get; set; } = 2.0f;

    private int _health;
    private int _enemyId;
    private Player _cachedPlayer;

    public int Health
    {
        get => _health;
        set
        {
            int oldHealth = _health;
            _health = Mathf.Max(0, value);
            if (_health != oldHealth)
            {
                EmitSignal(SignalName.HealthChanged, _health, oldHealth);
            }
        }
    }

    public override void _Ready()
    {
        _enemyId = GetInstanceId();
        Health = MaxHealth;
        
        // Connect signals
        HealthChanged += OnHealthChanged;
        BodyEntered += OnBodyEntered;
        
        // Setup collision
        var collision = new CollisionShape2D();
        var shape = new CircleShape2D();
        shape.Radius = 8.0f;
        collision.Shape = shape;
        AddChild(collision);
        
        // Add to group
        AddToGroup("enemies");
    }

    public override void _Process(double delta)
    {
        UpdateMovement(delta);
        UpdateAttack(delta);
    }

    private void UpdateMovement(double delta)
    {
        // Movement logic based on pattern
        switch (MovementPattern)
        {
            case "straight":
                Position += Vector2.Down * 100.0f * (float)delta;
                break;
            case "zigzag":
                // Implement zigzag movement
                break;
            // Add more patterns as needed
        }
    }

    private void UpdateAttack(double delta)
    {
        if (AttackPattern == "none")
            return;
        
        // Attack logic based on pattern
        // This would integrate with AttackBehavior components
    }

    public void TakeDamage(int amount)
    {
        Health -= amount;
    }

    private void OnHealthChanged(int newHealth, int oldHealth)
    {
        if (newHealth <= 0)
        {
            OnHealthDepleted();
        }
    }

    private void OnHealthDepleted()
    {
        EmitSignal(SignalName.Defeated, _enemyId, GlobalPosition, ScoreValue);
        EntityFactory.ReturnToPool(this, "enemy_popcorn");
    }

    private void OnBodyEntered(Node2D body)
    {
        if (body is Bullet bullet && bullet.IsPlayerBullet)
        {
            TakeDamage(bullet.Damage);
            bullet.QueueFree();
        }
    }

    public void ApplyTemplate(EnemyTemplate template)
    {
        if (template == null)
        {
            GD.PushError($"[Enemy:{Name}] apply_template called with null template");
            return;
        }

        MaxHealth = template.MaxHealth;
        ScoreValue = template.ScoreValue;
        MovementPattern = template.MovementType;
        AttackPattern = template.AttackPattern;
        AttackCooldown = template.AttackCooldown;
        
        Health = MaxHealth;
    }

    public void ResetForPool()
    {
        // Disconnect signals
        HealthChanged -= OnHealthChanged;
        BodyEntered -= OnBodyEntered;
        
        // Reset state
        GlobalPosition = Vector2.Zero;
        Health = MaxHealth;
        Visible = false;
        ProcessMode = ProcessModeEnum.Disabled;
        
        // Clear references
        _cachedPlayer = null;
    }
}
