        _cooldownTimer -= (float)delta;
        if (_cooldownTimer <= 0.0f)
        {
            ExecuteAttack();
            _cooldownTimer = Cooldown;
        }
    }

    protected virtual void ExecuteAttack()
    {
        // Override in subclasses
    }
}

// File: scripts/components/SpreadShotAttack.cs
public partial class SpreadShotAttack : AttackBehavior
{
    [Export] public int BulletCount { get; set; } = 5;
    [Export] public float SpreadAngle { get; set; } = 45.0f;

    protected override void ExecuteAttack()
    {
        var parent = GetParent<Node2D>();
        if (parent == null)
            return;
        
        float angleStep = SpreadAngle / (BulletCount - 1);
        float startAngle = -SpreadAngle / 2.0f;
        
        for (int i = 0; i < BulletCount; i++)
        {
            float angle = startAngle + angleStep * i;
            Vector2 direction = Vector2.Down.Rotated(Mathf.DegToRad(angle));
            
            var bullet = EntityFactory.SpawnBullet(BulletType, parent.GlobalPosition, direction);
            if (bullet != null)
            {
                bullet.Speed = BulletSpeed;
            }
        }
    }
}
