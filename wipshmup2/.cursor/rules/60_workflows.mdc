#### 2. Create Boss Class
```csharp
// File: scripts/boss/Boss.cs
public partial class Boss : Area2D
{
    [Signal] public delegate void PhaseChangedEventHandler(string bossId, int phaseNumber, string phaseName);
    [Signal] public delegate void DefeatedEventHandler(string bossId, float completionTime, bool noMiss);

    [ExportGroup("Stats")]
    [Export] public int MaxHealth { get; set; } = 1000;
    [Export] public int ScoreValue { get; set; } = 10000;

    private int _health;
    private string _bossId;
    private int _currentPhase = 0;
    private float _startTime;
    private bool _noMiss = true;

    public int Health
    {
        get => _health;
        set
        {
            _health = Mathf.Max(0, value);
            CheckPhaseTransition();
        }
    }

    public override void _Ready()
    {
        _bossId = Name;
        _startTime = Time.GetTicksMsec() / 1000.0f;
        Health = MaxHealth;
        
        // Connect signals
        BodyEntered += OnBodyEntered;
        
        // Setup collision
        var collision = new CollisionShape2D();
        var shape = new RectangleShape2D();
        shape.Size = new Vector2(64, 64);
        collision.Shape = shape;
        AddChild(collision);
        
        // Add to group
        AddToGroup("bosses");
        
        // Emit spawn event
        EventBus.EmitSignal(EventBus.SignalName.BossSpawned, this, _bossId);
    }

    public override void _Process(double delta)
    {
        UpdateBossBehavior(delta);
    }

    private void UpdateBossBehavior(double delta)
    {
        // Boss-specific behavior
        // This would integrate with movement and attack behaviors
    }

    private void CheckPhaseTransition()
    {
        float healthPercent = (float)Health / MaxHealth;
        var template = BossTemplateManager.GetTemplate(_bossId);
        if (template == null)
            return;
        
        for (int i = 0; i < template.Phases.Length; i++)
        {
            var phase = template.Phases[i];
            if (healthPercent <= phase.HealthThreshold && i > _currentPhase)
            {
                EnterPhase(phase);
                break;
            }
        }
    }

    private void EnterPhase(BossPhase phase)
    {
        _currentPhase = phase.PhaseNumber;
        
        // Clear old behaviors
        ClearBehaviors();
        
        // Apply new phase behaviors
        var movementBehavior = CreateMovementBehavior(phase.MovementPattern);
        if (movementBehavior != null)
        {
            AddChild(movementBehavior);
        }
        
        foreach (var attackPattern in phase.AttackPatterns)
        {
            var attackBehavior = CreateAttackBehavior(attackPattern);
            if (attackBehavior != null)
            {
                AddChild(attackBehavior);
            }
        }
        
        // Emit phase change event
        EventBus.EmitSignal(EventBus.SignalName.BossPhaseChanged, _bossId, phase.PhaseNumber, phase.PhaseName);
    }

    private Node CreateMovementBehavior(string pattern)
    {
        // Create appropriate movement behavior based on pattern
        return pattern switch
        {
            "circle" => new CircleMovementBehavior(),
            "straight" => new StraightMovementBehavior(),
            _ => null
        };
    }

    private Node CreateAttackBehavior(string pattern)
    {
        // Create appropriate attack behavior based on pattern
        return pattern switch
        {
            "spread_shot" => new SpreadShotAttack(),
            "laser_beam" => new LaserBeamAttack(),
            _ => null
        };
    }

    private void ClearBehaviors()
    {
        // Remove all behavior components
        var children = GetChildren().ToList();
        foreach (var child in children)
        {
            if (child is MovementBehavior or AttackBehavior)
            {
                child.QueueFree();
            }
        }
    }

    public void TakeDamage(int amount)
    {
        Health -= amount;
        if (Health <= 0)
        {
            OnDefeated();
        }
    }

    private void OnDefeated()
    {
        float completionTime = Time.GetTicksMsec() / 1000.0f - _startTime;
        EventBus.EmitSignal(EventBus.SignalName.BossDefeated, _bossId, completionTime, _noMiss);
        EntityFactory.ReturnToPool(this, "boss");
    }

    private void OnBodyEntered(Node2D body)
    {
        if (body is Bullet bullet && bullet.IsPlayerBullet)
        {
            TakeDamage(bullet.Damage);
            bullet.QueueFree();
        }
    }

    public void ApplyTemplate(BossTemplate template)
    {
        if (template == null)
        {
            GD.PushError($"[Boss:{Name}] apply_template called with null template");
            return;
        }

        MaxHealth = template.TotalHealth;
        ScoreValue = template.DefeatScore;
        Health = MaxHealth;
    }

    public void ResetForPool()
    {
        // Disconnect signals
        BodyEntered -= OnBodyEntered;
        
        // Reset state
        GlobalPosition = Vector2.Zero;
        Health = MaxHealth;
        _currentPhase = 0;
        _noMiss = true;
        Visible = false;
        ProcessMode = ProcessModeEnum.Disabled;
        
        // Clear behaviors
        ClearBehaviors();
    }
}
```

