// File: scripts/components/MovementBehavior.cs
public partial class MovementBehavior : Node
{
    [Export] public float Speed { get; set; } = 100.0f;
    [Export] public Node2D TargetNode { get; set; }

    public override void _PhysicsProcess(double delta)
    {
        var parent = GetParent<Node2D>();
        if (parent == null)
            return;
        
        Vector2 direction = CalculateDirection(parent.GlobalPosition);
        parent.Position += direction * Speed * (float)delta;
    }

    protected virtual Vector2 CalculateDirection(Vector2 currentPos)
    {
        // Override in subclasses
        return Vector2.Down;
    }
}

// File: scripts/components/CircleMovementBehavior.cs
public partial class CircleMovementBehavior : MovementBehavior
{
    [Export] public float CircleRadius { get; set; } = 50.0f;
    [Export] public float CircleSpeed { get; set; } = 1.0f;

    private float _angle = 0.0f;
    private Vector2 _centerPosition;

    public override void _Ready()
    {
        base._Ready();
        var parent = GetParent<Node2D>();
        if (parent != null)
        {
            _centerPosition = parent.GlobalPosition;
        }
    }

    protected override Vector2 CalculateDirection(Vector2 currentPos)
    {
        _angle += CircleSpeed * (float)GetPhysicsProcessDeltaTime();
        
        Vector2 circlePos = _centerPosition + new Vector2(
            Mathf.Cos(_angle) * CircleRadius,
            Mathf.Sin(_angle) * CircleRadius
        );
        
        return (circlePos - currentPos).Normalized();
    }
}
```

