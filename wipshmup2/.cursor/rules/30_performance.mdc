## Particle System Optimization

### GPU Particles vs CPU Particles
```csharp
// ✅ GOOD: Use GpuParticles2D for many particles
var explosionParticles = new GpuParticles2D();
explosionParticles.Amount = 100; // GPU handles efficiently
explosionParticles.OneShot = true;
explosionParticles.Emitting = true;

// ⚠️ CAUTION: Use CpuParticles2D only for <10 particles or when needing precise control
var trailParticles = new CpuParticles2D();
trailParticles.Amount = 5; // Small count

// ❌ BAD: CpuParticles2D with high counts
var particles = new CpuParticles2D();
particles.Amount = 500; // Will destroy framerate!
```

### Particle Pooling
```csharp
// ✅ GOOD: Pool particle systems
public async void SpawnExplosion(Vector2 pos)
{
    var particles = _particlePool.Acquire();
    if (particles == null)
    {
        return; // Pool exhausted, skip effect
    }
    
    particles.GlobalPosition = pos;
    particles.Emitting = true;
    particles.OneShot = true;
    
    // Return to pool when finished
    await ToSignal(GetTree().CreateTimer(particles.Lifetime), SceneTreeTimer.SignalName.Timeout);
    if (IsInstanceValid(particles))
    {
        particles.Emitting = false;
        _particlePool.Release(particles);
    }
}
```

## Profiling and Diagnostics

### Performance Monitoring
```csharp
// ✅ GOOD: Track frame times and entity counts
private readonly float[] _frameTimes = new float[60];
private int _frameTimeIndex = 0;

public override void _Process(double delta)
{
    // Record frame time
    _frameTimes[_frameTimeIndex] = (float)delta;
    _frameTimeIndex = (_frameTimeIndex + 1) % _frameTimes.Length;
    
    // Calculate average FPS
    float avgDelta = _frameTimes.Average();
    float avgFps = 1.0f / avgDelta;
    
    if (avgFps < 55.0f)
    {
        GD.PushWarning($"[Performance] FPS below target: {avgFps:F1}");
    }
}

public Dictionary<string, object> GetPerformanceStats()
{
    return new Dictionary<string, object>
    {
        ["active_bullets"] = EntityFactory.GetActiveCount("bullet"),
        ["active_enemies"] = EntityFactory.GetActiveCount("enemy"),
        ["active_particles"] = EntityFactory.GetActiveCount("particle"),
        ["fps"] = Engine.GetFramesPerSecond(),
        ["physics_time"] = Performance.GetMonitor(Performance.Monitor.TimePhysicsProcess),
        ["process_time"] = Performance.GetMonitor(Performance.Monitor.TimeProcess),
    };
}
```

