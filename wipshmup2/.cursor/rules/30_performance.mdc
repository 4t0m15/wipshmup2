### Shader Parameter Updates
```csharp
// ✅ GOOD: Update shader parameters sparingly
private float _lastShaderUpdate = 0.0f;
private const float ShaderUpdateInterval = 0.1f; // 10 FPS for shader params

public override void _Process(double delta)
{
    _lastShaderUpdate += (float)delta;
    if (_lastShaderUpdate >= ShaderUpdateInterval)
    {
        _material.SetShaderParameter("time", Time.GetTicksMsec() * 0.001f);
        _lastShaderUpdate = 0.0f;
    }
}

// ❌ BAD: Update every frame (60 FPS)
public override void _Process(double delta)
{
    _material.SetShaderParameter("time", Time.GetTicksMsec() * 0.001f);
}
