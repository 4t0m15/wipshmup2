### Pool Lifecycle Management
```csharp
// ✅ GOOD: Complete pool lifecycle implementation
public partial class BulletPool : Node
{
    private readonly List<Bullet> _activeBullets = new();
    private readonly List<Bullet> _inactiveBullets = new();
    private readonly int _poolSize = 200;

    public override void _Ready()
    {
        // Pre-allocate entire pool at startup
        for (int i = 0; i < _poolSize; i++)
        {
            var bullet = new Bullet();
            bullet.Visible = false;
            bullet.ProcessMode = ProcessModeEnum.Disabled;
            AddChild(bullet);
            _inactiveBullets.Add(bullet);
        }
    }

    public Bullet Acquire()
    {
        if (_inactiveBullets.Count == 0)
        {
            // Pool exhausted - degrade gracefully
            return null;
        }
        
        var bullet = _inactiveBullets[_inactiveBullets.Count - 1];
        _inactiveBullets.RemoveAt(_inactiveBullets.Count - 1);
        _activeBullets.Add(bullet);
        
        // Activate bullet (no allocation)
        bullet.Visible = true;
        bullet.ProcessMode = ProcessModeEnum.Inherit;
        
        return bullet;
    }

    public void Release(Bullet bullet)
    {
        // Deactivate bullet (no deallocation)
        bullet.Visible = false;
        bullet.ProcessMode = ProcessModeEnum.Disabled;
        bullet.Position = Vector2.Zero;
        bullet.Velocity = Vector2.Zero;
        
        // Move between pools
        _activeBullets.Remove(bullet);
        _inactiveBullets.Add(bullet);
    }

    // ❌ BAD: Incomplete pooling with allocations
    public void Release(Bullet bullet)
    {
        bullet.QueueFree(); // Defeats the purpose of pooling!
        _activeBullets.Remove(bullet);
    }
}
```

### Pool Reuse Pattern
```csharp
// ✅ GOOD: Complete state reset for reused objects
public void ResetForPool()
{
    // 1. Disconnect ALL signals (critical for avoiding leaks)
    foreach (var connection in GetIncomingConnections())
    {
        var signal = connection.Signal;
        if (signal.IsConnected(connection.Callable))
        {
            signal.Disconnect(connection.Callable);
        }
    }
    
    // 2. Reset position and physics
    GlobalPosition = Vector2.Zero;
    Velocity = Vector2.Zero;
    Rotation = 0.0f;
    Scale = Vector2.One;
    
    // 3. Reset gameplay state
    Damage = 0;
    Lifetime = 0.0f;
    IsPlayerBullet = false;
    
    // 4. Clear references (prevent memory leaks)
    TargetNode = null;
    SourceNode = null;
    
    // 5. Reset visual state
    Modulate = Colors.White;
    Visible = false;
    
    // 6. Disable processing
    ProcessMode = ProcessModeEnum.Disabled;
    SetPhysicsProcess(false);
    SetProcess(false);
}

// ❌ BAD: Incomplete reset leaves stale state
public void ResetForPool()
{
    Position = Vector2.Zero;
    // Forgot: signals, velocity, references, processing state!
}
```

## Rate Limiting

### Bullet Spawn Rate Limiting
```csharp
// ✅ GOOD: Rate limiter with per-second caps
public partial class RateLimiter : Node
{
    [Export] public int MaxPerSecond { get; set; } = 300;
    [Export] public int BurstAllowance { get; set; } = 50;

    private int _spawnCountThisSecond = 0;
    private float _timeAccumulator = 0.0f;

    public override void _Process(double delta)
    {
        _timeAccumulator += (float)delta;
        if (_timeAccumulator >= 1.0f)
        {
            _timeAccumulator = 0.0f;
            _spawnCountThisSecond = 0;
        }
    }

    public bool CanSpawn()
    {
        return _spawnCountThisSecond < MaxPerSecond + BurstAllowance;
    }

    public void RegisterSpawn()
    {
        _spawnCountThisSecond++;
    }
}

// Usage in spawn logic
public void FireBullet()
{
    if (!_rateLimiter.CanSpawn())
    {
        // Degrade gracefully - skip this bullet
        return;
    }
    
    var bullet = EntityFactory.SpawnBullet("enemy_basic", Position, Direction);
    if (bullet != null)
    {
        _rateLimiter.RegisterSpawn();
    }
}

// ❌ BAD: No rate limiting - performance spikes
public void FireBulletPattern()
{
    for (int i = 0; i < 360; i++) // 360 bullets at once!
    {
        var bullet = EntityFactory.SpawnBullet(...);
    }
}
```

### Graceful Degradation
```csharp
// ✅ GOOD: Skip non-critical spawns when under load
public void SpawnEnemyWave()
{
    var activeCount = GetActiveBulletCount();
    
    if (activeCount > 400)
    {
        // High load - reduce spawn rate
        if (GD.Randf() > 0.5f)
        {
            return; // Skip 50% of spawns
        }
    }
    
    if (activeCount > 600)
    {
        // Critical load - skip all non-essential spawns
        GD.PushWarning($"[Spawner] High bullet count ({activeCount}), skipping enemy spawn");
        return;
    }
    
    var enemy = EntityFactory.SpawnEnemy("popcorn_01", position, direction);
}

// ✅ GOOD: Reduce visual effects under load
public void SpawnHitParticles(Vector2 position)
{
    if (GetActiveParticleCount() > 50)
    {
        return; // Skip particles when too many active
    }
    
    var particles = EntityFactory.SpawnEffect("hit_spark", position);
}

// ❌ BAD: No degradation - guaranteed frame drops
public void SpawnWave()
{
    for (int i = 0; i < 100; i++) // Always spawn 100, even if lagging
    {
        SpawnEnemy();
    }
}
```

## Per-Frame Performance Optimization

### Cache Node References
```csharp
// ✅ GOOD: Cached references with lazy initialization
private Player _cachedPlayer;
private GameState _cachedGameState;

private Player GetPlayer()
{
    if (_cachedPlayer == null || !IsInstanceValid(_cachedPlayer))
    {
        _cachedPlayer = GetTree().GetFirstNodeInGroup("player") as Player;
    }
    return _cachedPlayer;
}

public override void _PhysicsProcess(double delta)
{
    var player = GetPlayer();
    if (player == null)
        return;
    
    // Use cached reference (no tree traversal)
    var directionToPlayer = (player.GlobalPosition - GlobalPosition).Normalized();
    Velocity = directionToPlayer * Speed;
}

// ❌ BAD: Repeated node lookups every frame
public override void _PhysicsProcess(double delta)
{
    var player = GetNode<Player>("/root/Main/Player"); // Tree traversal every frame!
    var direction = (player.Position - Position).Normalized();
}
```

### Avoid Allocations in Process Functions
```csharp
// ✅ GOOD: Reuse vectors, no allocations
private Vector2 _directionCache = Vector2.Zero;
private Vector2 _velocityCache = Vector2.Zero;

public override void _PhysicsProcess(double delta)
{
    // Reuse cached vectors
    _directionCache = (_targetPosition - GlobalPosition).Normalized();
    _velocityCache = _directionCache * Speed;
    GlobalPosition += _velocityCache * (float)delta;
}

// ❌ BAD: Allocates new vectors every frame
public override void _PhysicsProcess(double delta)
{
    var direction = (_targetPosition - GlobalPosition).Normalized(); // Allocation
    var velocity = direction * Speed; // Another allocation
    GlobalPosition += velocity * (float)delta; // Another allocation
}
```

### Batch Operations
```csharp
// ✅ GOOD: Batch processing with early outs
public void UpdateAllBullets(double delta)
{
    // Iterate backwards to allow safe removal
    for (int i = _activeBullets.Count - 1; i >= 0; i--)
    {
        var bullet = _activeBullets[i];
        
        // Quick validity check
        if (bullet == null || !IsInstanceValid(bullet))
        {
            _activeBullets.RemoveAt(i);
            continue;
        }
        
        // Update bullet
        bullet.Position += bullet.Velocity * (float)delta;
        
        // Bounds check (cheap operation first)
        if (IsOutOfBounds(bullet.Position))
        {
            ReturnBulletToPool(bullet);
            _activeBullets.RemoveAt(i);
        }
    }
}

// ⚠️ CAUTION: Avoid nested loops over large collections
public void CheckAllCollisions()
{
    // O(n*m) - expensive with 500 bullets and 50 enemies!
    foreach (var bullet in _bullets)
    {
        foreach (var enemy in _enemies)
        {
            if (bullet.Overlaps(enemy))
            {
                HandleCollision(bullet, enemy);
            }
        }
    }
}

// ✅ BETTER: Use spatial partitioning or quadtree
public void CheckAllCollisions()
{
    var spatialGrid = BuildSpatialGrid(_enemies, 64); // 64px cells
    
    foreach (var bullet in _bullets)
    {
        var nearbyEnemies = spatialGrid.Query(bullet.Position, bullet.CollisionRadius);
        foreach (var enemy in nearbyEnemies)
        {
            if (bullet.Overlaps(enemy))
            {
                HandleCollision(bullet, enemy);
            }
        }
    }
}
```

### Minimize GetTree().GetNodesInGroup() Calls
```csharp
// ❌ VERY BAD: Calling in _Process (traverses entire tree every frame!)
public override void _Process(double delta)
{
    var enemies = GetTree().GetNodesInGroup("enemies");
    foreach (var enemy in enemies)
    {
        UpdateEnemy(enemy);
    }
}

// ✅ GOOD: Cache group and update via signals
private List<Enemy> _enemyCache = new();

public override void _Ready()
{
    EventBus.EnemySpawned += OnEnemySpawned;
    EventBus.EnemyDefeated += OnEnemyDefeated;
    RefreshEnemyCache();
}

private void RefreshEnemyCache()
{
    _enemyCache.Clear();
    var enemies = GetTree().GetNodesInGroup("enemies");
    foreach (var enemy in enemies)
    {
        if (enemy is Enemy enemyNode)
        {
            _enemyCache.Add(enemyNode);
        }
    }
}

private void OnEnemySpawned(Enemy enemy, string templateId)
{
    _enemyCache.Add(enemy);
}

private void OnEnemyDefeated(int enemyId, Vector2 pos, int score)
{
    // Remove invalid entries on next process
    _cacheDirty = true;
}

private bool _cacheDirty = false;

public override void _Process(double delta)
{
    if (_cacheDirty)
    {
        _enemyCache = _enemyCache.Where(e => e != null && IsInstanceValid(e)).ToList();
        _cacheDirty = false;
    }
    
    foreach (var enemy in _enemyCache)
    {
        UpdateEnemy(enemy);
    }
}
```

## Math Optimization

### Integer Math for Counters
```csharp
// ✅ GOOD: Integer operations for counts
int bulletCount = 500;
int halfBullets = bulletCount >> 1; // Bit shift (faster than division)
int quarterBullets = bulletCount >> 2;

// ✅ GOOD: Use explicit integer division
int enemiesPerRow = bulletCount / rowCount; // Integer division in C#

// ⚠️ CAUTION: Division returns int for int operands in C#
int result = 10 / 2; // Returns 5 (int)
float resultFloat = 10.0f / 2.0f; // Returns 5.0f (float)
```

### Trigonometry Optimization
```csharp
// ✅ GOOD: Pre-calculate trigonometric values
private const float AngleStep = Mathf.Tau / 360.0f;
private readonly float[] _cosTable = new float[360];
private readonly float[] _sinTable = new float[360];

public override void _Ready()
{
    // Build lookup tables at startup
    for (int i = 0; i < 360; i++)
    {
        float angle = i * AngleStep;
        _cosTable[i] = Mathf.Cos(angle);
        _sinTable[i] = Mathf.Sin(angle);
    }
}

public Vector2 GetDirectionFromAngle(int angleDegrees)
{
    int index = angleDegrees % 360;
    return new Vector2(_cosTable[index], _sinTable[index]);
}

// ❌ BAD: Calculating sin/cos every frame
public Vector2 GetDirection(float angle)
{
    return new Vector2(Mathf.Cos(angle), Mathf.Sin(angle)); // Expensive!
}
```

### Vector Operations
```csharp
// ✅ GOOD: Avoid sqrt when possible (use squared distance)
public bool IsInRange(Vector2 targetPos, float maxRange)
{
    float distSquared = GlobalPosition.DistanceSquaredTo(targetPos);
    return distSquared <= maxRange * maxRange;
}

// ❌ BAD: Unnecessary sqrt calculation
public bool IsInRange(Vector2 targetPos, float maxRange)
{
    float dist = GlobalPosition.DistanceTo(targetPos); // sqrt inside!
    return dist <= maxRange;
}

// ✅ GOOD: Reuse normalized vectors
private Vector2 _lastDirection = Vector2.Down;
private bool _directionDirty = true;

public Vector2 GetMovementDirection()
{
    if (_directionDirty)
    {
        _lastDirection = (_targetPosition - Position).Normalized();
        _directionDirty = false;
    }
    return _lastDirection;
}
```

