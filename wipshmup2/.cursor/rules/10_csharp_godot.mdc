### Control Flow
```csharp
// ✅ CORRECT: Switch expressions (C# 8+)
var result = enemyType switch
{
    "fighter" => SpawnFighter(),
    "tank" => SpawnTank(),
    "boss" => SpawnBoss(),
    _ => SpawnDefault()
};

// ✅ CORRECT: Traditional switch
switch (enemyType)
{
    case "fighter":
        SpawnFighter();
        break;
    case "tank":
        SpawnTank();
        break;
    case "boss":
        SpawnBoss();
        break;
    default:
        SpawnDefault();
        break;
}

// ✅ CORRECT: Early returns (preferred)
public void AttackTarget(Node2D target)
{
    if (target == null || !IsInstanceValid(target))
        return;
    
    if (_attackCooldown > 0.0f)
        return;
    
    if (!IsInAttackRange(target))
        return;
    
    // Main logic here
    FireBulletAt(target);
    _attackCooldown = AttackCooldownDuration;
}

// ❌ WRONG: Deep nesting
public void AttackTarget(Node2D target)
{
    if (target != null && IsInstanceValid(target))
    {
        if (_attackCooldown <= 0.0f)
        {
            if (IsInAttackRange(target))
            {
                FireBulletAt(target);
                _attackCooldown = AttackCooldownDuration;
            }
        }
    }
}
```

### Loops and Iteration
```csharp
// ✅ CORRECT: For loops
for (int i = 0; i < 10; i++)
{
    GD.Print(i);
}

// ✅ CORRECT: Foreach loops
foreach (var enemy in _enemies)
{
    enemy.TakeDamage(10);
}

// ✅ CORRECT: Safe iteration with removal
for (int i = _enemies.Count - 1; i >= 0; i--)
{
    var enemy = _enemies[i];
    if (enemy == null || !IsInstanceValid(enemy))
    {
        _enemies.RemoveAt(i);
        continue;
    }
    enemy.UpdateLogic(delta);
}

// ✅ CORRECT: LINQ operations (use sparingly for performance)
var aliveEnemies = _enemies.Where(e => e != null && IsInstanceValid(e)).ToList();
var bossEnemies = _enemies.Where(e => e.IsBoss).ToList();

// ❌ WRONG: Modifying collection during foreach
foreach (var enemy in _enemies)
{
    if (enemy.Health <= 0)
    {
        _enemies.Remove(enemy); // Exception!
    }
}
```

