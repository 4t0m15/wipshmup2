### Node Access Patterns
```csharp
// ✅ CORRECT: Cached node references
private Sprite2D _sprite;
private CollisionShape2D _collision;
private Player _cachedPlayer;

public override void _Ready()
{
    _sprite = GetNode<Sprite2D>("Sprite2D");
    _collision = GetNode<CollisionShape2D>("CollisionShape2D");
    _cachedPlayer = GetNodeOrNull<Player>("/root/Main/Player");
}

// ✅ CORRECT: Safe node access with validation
public Player GetPlayer()
{
    if (_cachedPlayer == null || !IsInstanceValid(_cachedPlayer))
    {
        _cachedPlayer = GetNodeOrNull<Player>("/root/Main/Player");
    }
    return _cachedPlayer;
}

// ✅ CORRECT: Type-safe node access
var enemy = GetNode<Enemy>("Enemy");
var bullet = GetNodeOrNull<Bullet>("Bullet");

// ❌ WRONG: Unsafe node access
var player = GetNode<Player>("Player"); // Crashes if missing
var enemy = GetNode("Enemy") as Enemy; // Less type-safe
```

### Collections and Data Structures
```csharp
// ✅ CORRECT: Use List<T> for dynamic collections
private List<Enemy> _enemies = new();
private List<Bullet> _activeBullets = new();

// ✅ CORRECT: Use Dictionary<TKey, TValue> for key-value pairs
private Dictionary<int, int> _healthMap = new();
private Dictionary<string, EnemyTemplate> _templates = new();

// ✅ CORRECT: Use Godot.Collections.Array<T> when needed for Godot integration
private Godot.Collections.Array<Enemy> _godotEnemies = new();

// ✅ CORRECT: Collection operations
_enemies.Add(enemy);
_enemies.Remove(enemy);
_enemies.RemoveAt(index);
_enemies.Clear();

// Check existence
if (_enemies.Contains(enemy))
{
    // Handle
}

// Safe iteration with removal
for (int i = _enemies.Count - 1; i >= 0; i--)
{
    var enemy = _enemies[i];
    if (enemy == null || !IsInstanceValid(enemy))
    {
        _enemies.RemoveAt(i);
        continue;
    }
    // Process enemy
}

// ❌ WRONG: Using arrays for dynamic collections
private Enemy[] _enemies = new Enemy[100]; // Fixed size, not suitable for dynamic content
```

