### Async/Await Patterns
```csharp
// ✅ CORRECT: Async method declaration
public async Task DelayedAttack()
{
    await ToSignal(GetTree().CreateTimer(2.0), SceneTreeTimer.SignalName.Timeout);
    
    // Re-validate after await
    if (!IsInstanceValid(this))
        return;
    
    if (_target == null || !IsInstanceValid(_target))
    {
        GD.PushWarning("[Enemy] Target became invalid during attack delay");
        return;
    }
    
    FireBulletAtTarget();
}

// ✅ CORRECT: Signal awaiting
public async Task WaitForPlayerDeath()
{
    var timeout = GetTree().CreateTimer(10.0);
    var result = await ToSignal(EventBus, EventBus.SignalName.PlayerDied)
        .Or(ToSignal(timeout, SceneTreeTimer.SignalName.Timeout));
    
    if (!IsInstanceValid(this))
        return;
    
    if (result == timeout)
    {
        GD.PushWarning("[Enemy] Timeout waiting for player death");
        return;
    }
    
    OnPlayerDeathConfirmed();
}

// ❌ WRONG: Missing async keyword
public Task DelayedAttack() // Missing async
{
    await ToSignal(GetTree().CreateTimer(2.0), SceneTreeTimer.SignalName.Timeout);
}
```

### Error Handling and Logging
```csharp
// ✅ CORRECT: Use GD methods for logging
GD.Print("Debug message");
GD.PushWarning("Warning message");
GD.PushError("Error message");

// ✅ CORRECT: Structured error messages
if (template == null)
{
    GD.PushError($"[Enemy:{Name}] apply_template called with null template. Using default template instead.");
    template = EnemyTemplateManager.GetDefaultTemplate();
}

// ✅ CORRECT: Exception handling
try
{
    var result = RiskyOperation();
    return result;
}
catch (Exception ex)
{
    GD.PushError($"[Enemy] Operation failed: {ex.Message}");
    return GetDefaultValue();
}

// ❌ WRONG: Using Console.WriteLine
Console.WriteLine("Debug message"); // Use GD.Print instead
```

### Property Patterns
```csharp
// ✅ CORRECT: Properties with validation
private int _health = 100;

[Export]
public int Health
{
    get => _health;
    set
    {
        int oldHealth = _health;
        _health = Mathf.Max(0, value);
        if (_health != oldHealth)
        {
            EmitSignal(SignalName.HealthChanged, _health, oldHealth);
        }
    }
}

// ✅ CORRECT: Read-only properties
public bool IsAlive => _health > 0;
public float HealthPercentage => (float)_health / _maxHealth;

// ✅ CORRECT: Computed properties
public Vector2 DirectionToPlayer
{
    get
    {
        var player = GetPlayer();
        if (player == null)
            return Vector2.Down;
        return (player.GlobalPosition - GlobalPosition).Normalized();
    }
}
```

### Common C# Gotchas

1. **Partial class required**: All C# scripts must use `partial` keyword
2. **SignalName enum**: Access signals via `SignalName.MySignal` not string
3. **PropertyName enum**: Similar for property names
4. **Callable.From()**: May need for signal connections with parameters
5. **await**: Requires `async` method and different syntax than GDScript
6. **null vs IsInstanceValid**: Use `IsInstanceValid()` for nodes that might be freed
7. **File paths**: Still use forward slashes `res://` not backslashes
8. **Case sensitivity**: C# is case-sensitive everywhere
9. **Float literals**: Always use `f` suffix: `100.0f` not `100.0`
10. **Delta parameter**: Use `double` not `float` for `_Process` and `_PhysicsProcess`

### Performance Considerations

```csharp
// ✅ CORRECT: Cache expensive operations
private Vector2 _cachedDirection = Vector2.Zero;
private bool _directionDirty = true;

public Vector2 GetMovementDirection()
{
    if (_directionDirty)
    {
        _cachedDirection = (_targetPosition - GlobalPosition).Normalized();
        _directionDirty = false;
    }
    return _cachedDirection;
}

// ✅ CORRECT: Avoid allocations in hot paths
private readonly List<Enemy> _tempEnemies = new(); // Reuse for temporary operations

public void UpdateAllEnemies(double delta)
{
    _tempEnemies.Clear();
    _tempEnemies.AddRange(_enemies.Where(e => e != null && IsInstanceValid(e)));
    
    foreach (var enemy in _tempEnemies)
    {
        enemy.UpdateLogic(delta);
    }
}

// ❌ WRONG: Allocations in hot paths
public void UpdateAllEnemies(double delta)
{
    var validEnemies = _enemies.Where(e => e != null && IsInstanceValid(e)).ToList(); // Allocation every frame!
    foreach (var enemy in validEnemies)
    {
        enemy.UpdateLogic(delta);
    }
}
```

## Summary

Follow these C# patterns religiously:
- Use `partial` keyword for all classes
- Use proper method signatures with `override`
- Use `SignalName` enum for signal access
- Use `Mathf` for math operations
- Use `GD` methods for logging and random
- Use `IsInstanceValid()` for node validation
- Use string interpolation for formatting
- Use early returns instead of deep nesting
- Cache expensive operations
- Avoid allocations in hot paths