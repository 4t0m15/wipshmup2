## Signal Safety

### Connection Validation
```csharp
// ✅ GOOD: Check if already connected before connecting
public override void _Ready()
{
    if (!EventBus.PlayerDied.IsConnected(OnPlayerDied))
    {
        EventBus.PlayerDied += OnPlayerDied;
    }
    
    if (_enemy != null && !_enemy.HealthChanged.IsConnected(OnEnemyHealthChanged))
    {
        _enemy.HealthChanged += OnEnemyHealthChanged;
    }
}

// ❌ BAD: Double connection creates duplicate calls
public override void _Ready()
{
    EventBus.PlayerDied += OnPlayerDied;
    // If _Ready() called twice (e.g. scene reload), signal connected twice!
}
```

### Disconnection Safety
```csharp
// ✅ GOOD: Safe disconnection with validation
public override void _ExitTree()
{
    if (EventBus.PlayerDied.IsConnected(OnPlayerDied))
    {
        EventBus.PlayerDied -= OnPlayerDied;
    }
    
    if (_targetEnemy != null && IsInstanceValid(_targetEnemy))
    {
        if (_targetEnemy.Defeated.IsConnected(OnEnemyDefeated))
        {
            _targetEnemy.Defeated -= OnEnemyDefeated;
        }
    }
}

// ✅ GOOD: Disconnect all incoming connections
public void DisconnectAllSignals()
{
    foreach (var connection in GetIncomingConnections())
    {
        var signal = connection.Signal;
        if (signal.IsConnected(connection.Callable))
        {
            signal.Disconnect(connection.Callable);
        }
    }
}

// ❌ BAD: Disconnect without checking
public override void _ExitTree()
{
    EventBus.PlayerDied -= OnPlayerDied; // Error if not connected!
}
```

### Signal Handlers with Validation
```csharp
// ✅ GOOD: Validate signal parameters
private void OnEnemyDefeated(int enemyId, Vector2 position, int score)
{
    if (enemyId < 0)
    {
        GD.PushError($"[ScoreSystem] Invalid enemy_id: {enemyId}");
        return;
    }
    
    if (score < 0)
    {
        GD.PushWarning($"[ScoreSystem] Negative score value: {score}, clamping to 0");
        score = 0;
    }
    
    GameState.AddScore(score);
    SpawnScorePopup(position, score);
}

// ❌ BAD: Assume parameters are valid
private void OnEnemyDefeated(int enemyId, Vector2 position, int score)
{
    GameState.AddScore(score); // What if score is -999999?
}
```

## Async/Await Safety (Critical)

### Re-validate After Await
```csharp
// ✅ GOOD: Re-check validity after every await
public async Task DelayedAttack()
{
    await ToSignal(GetTree().CreateTimer(2.0), SceneTreeTimer.SignalName.Timeout);
    
    // Node might have been freed during wait!
    if (!IsInstanceValid(this))
        return;
    
    if (_target == null || !IsInstanceValid(_target))
    {
        GD.PushWarning("[Enemy] Target became invalid during attack delay");
        return;
    }
    
    FireBulletAtTarget();
}

// ✅ GOOD: Multiple await points, validate each
public async Task BossIntroSequence()
{
    EventBus.EmitSignal(EventBus.SignalName.BossWarning, _bossId, 3.0f);
    await ToSignal(GetTree().CreateTimer(3.0), SceneTreeTimer.SignalName.Timeout);
    
    if (!IsInstanceValid(this))
        return;
    
    EnterPhase1();
    await ToSignal(this, SignalName.Phase1PatternComplete);
    
    if (!IsInstanceValid(this))
        return;
    
    EnterPhase2();
}

// ❌ BAD: Assume node still exists after await
public async Task DelayedAttack()
{
    await ToSignal(GetTree().CreateTimer(2.0), SceneTreeTimer.SignalName.Timeout);
    FireBulletAtTarget(); // CRASH if freed during wait!
}
```

### Safe Signal Awaiting
```csharp
// ✅ GOOD: Timeout protection for awaits
public async Task WaitForPlayerDeath()
{
    var timeout = GetTree().CreateTimer(10.0);
    var result = await ToSignal(EventBus, EventBus.SignalName.PlayerDied)
        .Or(ToSignal(timeout, SceneTreeTimer.SignalName.Timeout));
    
    if (!IsInstanceValid(this))
        return;
    
    if (result == timeout)
    {
        GD.PushWarning("[Enemy] Timeout waiting for player death");
        return;
    }
    
    OnPlayerDeathConfirmed();
}

// ❌ BAD: Await without timeout (could hang forever)
public async Task WaitForPlayerDeath()
{
    await ToSignal(EventBus, EventBus.SignalName.PlayerDied);
    OnPlayerDeathConfirmed(); // What if signal never fires?
}
```

## Error Handling and Reporting

### GD.PushError() for Critical Failures
```csharp
// ✅ GOOD: Descriptive error messages with context
public StageDefinition LoadStageDefinition(int stageId)
{
    if (stageId < 1)
    {
        GD.PushError($"[StageManager] Invalid stage_id: {stageId} (must be >= 1)");
        return GetDefaultStage();
    }
    
    var stagePath = $"res://config/stages/stage_{stageId:D2}.tres";
    if (!ResourceLoader.Exists(stagePath))
    {
        GD.PushError($"[StageManager] Stage file not found: {stagePath}");
        return GetDefaultStage();
    }
    
    var stage = GD.Load<StageDefinition>(stagePath);
    if (stage == null)
    {
        GD.PushError($"[StageManager] Failed to load stage from: {stagePath}");
        return GetDefaultStage();
    }
    
    return stage;
}

// ❌ BAD: Silent failure or vague error
public StageDefinition LoadStageDefinition(int stageId)
{
    var stage = GD.Load<StageDefinition>($"res://config/stages/stage_{stageId:D2}.tres");
    if (stage == null)
    {
        GD.PushError("Stage load failed"); // Which stage? Why?
        return null; // Crash later when used!
    }
    return stage;
}
```

### GD.PushWarning() for Non-Critical Issues
```csharp
// ✅ GOOD: Warnings for recoverable issues
public void SpawnEnemyWave(int enemyCount)
{
    if (enemyCount > 100)
    {
        GD.PushWarning($"[Spawner] High enemy count ({enemyCount}), may impact performance");
    }
    
    if (enemyCount <= 0)
    {
        GD.PushWarning($"[Spawner] Invalid enemy_count: {enemyCount}, skipping wave");
        return;
    }
    
    for (int i = 0; i < enemyCount; i++)
    {
        SpawnSingleEnemy();
    }
}

// ❌ BAD: Use error for non-critical issue
public void SpawnEnemyWave(int enemyCount)
{
    if (enemyCount > 100)
    {
        GD.PushError("Too many enemies!"); // Not an error, just a warning
    }
}
```

### Structured Error Messages
```csharp
// ✅ GOOD: Structured error with system name, context, and solution
public void ApplyTemplate(EnemyTemplate template)
{
    if (template == null)
    {
        GD.PushError($"[Enemy:{Name}] apply_template called with null template. Using default template instead.");
        template = EnemyTemplateManager.GetDefaultTemplate();
    }
    
    if (template.MaxHealth <= 0)
    {
        GD.PushError($"[Enemy:{Name}] Template '{template.TemplateId}' has invalid health ({template.MaxHealth}). Setting to 10.");
        template.MaxHealth = 10;
    }
    
    // Apply template...
}

// Format: [System:Context] Problem description. Resolution.
```

## Safe Defaults Pattern

### Configuration with Fallbacks
```csharp
// ✅ GOOD: Layered fallback system
public Dictionary<string, object> LoadConfig(string path)
{
    // Try loading custom config
    if (FileAccess.FileExists(path))
    {
        var config = ParseJsonFile(path);
        if (config.Count > 0)
        {
            return ApplyDefaults(MergeConfigs(_defaultConfig, config));
        }
    }
    
    // Fall back to default config
    GD.PushWarning($"[ConfigLoader] Using default config (file not found: {path})");
    return new Dictionary<string, object>(_defaultConfig);
}

private Dictionary<string, object> ApplyDefaults(Dictionary<string, object> config)
{
    var result = new Dictionary<string, object>(config);
    foreach (var kvp in _defaultConfig)
    {
        if (!result.ContainsKey(kvp.Key))
        {
            result[kvp.Key] = kvp.Value;
        }
    }
    return result;
}

// ❌ BAD: No fallback, crash on missing config
public Dictionary<string, object> LoadConfig(string path)
{
    var file = FileAccess.Open(path, FileAccess.ModeFlags.Read);
    return Json.ParseString(file.GetAsText()); // CRASH if file missing!
}
```

### Safe Resource Loading
```csharp
// ✅ GOOD: Multiple fallback layers
public Texture2D GetEnemyTexture(string texturePath)
{
    // Try loading requested texture
    if (ResourceLoader.Exists(texturePath))
    {
        var tex = GD.Load<Texture2D>(texturePath);
        if (tex != null)
            return tex;
    }
    
    // Try fallback texture
    GD.PushWarning($"[Assets] Texture not found: {texturePath}, using fallback");
    if (_fallbackTexture != null)
        return _fallbackTexture;
    
    // Emergency fallback: placeholder texture
    GD.PushError("[Assets] Fallback texture is null! Using generated placeholder");
    return GeneratePlaceholderTexture();
}

private Texture2D GeneratePlaceholderTexture()
{
    var img = Image.Create(32, 32, false, Image.Format.Rgb8);
    img.Fill(Colors.Magenta); // Obvious placeholder
    return ImageTexture.CreateFromImage(img);
}
```

## Division by Zero Protection

### Safe Division with Clamping
```csharp
// ✅ GOOD: Prevent division by zero
public float CalculateDamageMultiplier(float distance, float maxRange)
{
    if (maxRange <= 0.0f)
    {
        GD.PushWarning($"[Combat] Invalid max_range: {maxRange:F2}, using 1.0");
        maxRange = 1.0f;
    }
    
    float normalizedDist = Mathf.Clamp(distance / maxRange, 0.0f, 1.0f);
    return 1.0f - normalizedDist;
}

// ✅ GOOD: Check denominator before division
public float CalculateAccuracy(int hits, int shots)
{
    if (shots <= 0)
        return 0.0f; // No shots fired = 0% accuracy
    
    return (float)hits / shots;
}

// ❌ BAD: No zero check
public float CalculateAccuracy(int hits, int shots)
{
    return (float)hits / shots; // CRASH if shots == 0!
}
```

## Scene Tree Safety

### Deferred Operations
```csharp
// ✅ GOOD: Deferred tree modifications
public void OnHealthDepleted()
{
    CallDeferred(nameof(HandleDeath));
}

private void HandleDeath()
{
    // Safe to modify tree here
    var explosion = SpawnExplosionEffect();
    GetParent().AddChild(explosion);
    QueueFree();
}

// ✅ GOOD: Deferred in signal handlers
public void OnBulletHit(Node2D body)
{
    body.CallDeferred(nameof(ITakeDamage.TakeDamage), Damage);
    CallDeferred(nameof(QueueFree));
}

// ❌ BAD: Immediate tree modification during physics
public override void _PhysicsProcess(double delta)
{
    if (Health <= 0)
    {
        GetParent().AddChild(explosion); // CRASH!
        QueueFree(); // CRASH!
    }
}
```

### Parent Validation
```csharp
// ✅ GOOD: Validate parent before operations
public void SpawnItemDrop()
{
    var parent = GetParent();
    if (parent == null || !IsInstanceValid(parent))
    {
        GD.PushError("[Enemy] No valid parent to spawn item into");
        return;
    }
    
    var item = EntityFactory.SpawnItem("power_up", GlobalPosition);
    if (item != null)
    {
        parent.CallDeferred(nameof(Node.AddChild), item);
    }
}

// ❌ BAD: Assume parent exists
