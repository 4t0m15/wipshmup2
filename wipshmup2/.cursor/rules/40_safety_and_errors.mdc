### Cached References with Validation
```csharp
// ✅ GOOD: Lazy-loaded cached reference with validation
private Player _cachedPlayer;

public Player GetPlayer()
{
    // Re-validate cached reference
    if (_cachedPlayer == null || !IsInstanceValid(_cachedPlayer))
    {
        _cachedPlayer = GetTree().GetFirstNodeInGroup("player") as Player;
        if (_cachedPlayer == null)
        {
            // Player doesn't exist yet or was removed
            return null;
        }
    }
    return _cachedPlayer;
}

public override void _PhysicsProcess(double delta)
{
    var player = GetPlayer();
    if (player == null)
    {
        // No player - idle behavior
        return;
    }
    
    // Safe to use player here
    PursueTarget(player.GlobalPosition);
}

// ❌ BAD: Cache once, never re-validate
private Player _cachedPlayer;

public override void _Ready()
{
    _cachedPlayer = GetNode<Player>("/root/Main/Player");
}

public override void _PhysicsProcess(double delta)
{
    // CRASH if player died and was removed!
    var dir = (_cachedPlayer.Position - Position).Normalized();
}
```

### Weak References (Advanced)
```csharp
// ✅ GOOD: Use WeakRef for optional references
private WeakRef _targetWeakRef;

public void SetTarget(Node target)
{
    _targetWeakRef = WeakRef(target);
}

public Node GetTarget()
{
    if (_targetWeakRef == null)
        return null;
    
    var target = _targetWeakRef.GetRef() as Node;
    if (target == null || !IsInstanceValid(target))
    {
        _targetWeakRef = null;
        return null;
    }
    return target;
}
```

## Array and Collection Safety

### Bounds Checking
```csharp
// ✅ GOOD: Always check array size before access
public Enemy GetEnemyAtIndex(int index)
{
    if (index < 0 || index >= _enemies.Count)
    {
        GD.PushError($"[EnemyManager] Index {index} out of bounds (size: {_enemies.Count})");
        return null;
    }
    return _enemies[index];
}

// ✅ GOOD: Safe iteration with size check
public void UpdateAllEnemies(double delta)
{
    if (_enemies.Count == 0)
        return;
    
    // Iterate backwards for safe removal
    for (int i = _enemies.Count - 1; i >= 0; i--)
    {
        var enemy = _enemies[i];
        if (enemy != null && IsInstanceValid(enemy))
        {
            enemy.UpdateLogic(delta);
        }
        else
        {
            _enemies.RemoveAt(i);
        }
    }
}

// ❌ BAD: No bounds checking
public Enemy GetEnemy(int index)
{
    return _enemies[index]; // CRASH if index >= Count!
}
```

### Safe Dictionary Access
```csharp
// ✅ GOOD: Use TryGetValue with defaults
public int GetEnemyHealth(int enemyId)
{
    return _healthMap.TryGetValue(enemyId, out int health) ? health : 0;
}

public EnemyTemplate GetTemplate(string templateId)
{
    if (!_templates.TryGetValue(templateId, out var template))
    {
        GD.PushError($"[TemplateManager] Template '{templateId}' not found, using default");
        return _defaultTemplate;
    }
    return template;
}

// ✅ GOOD: Check ContainsKey before access
public void ApplyDamage(int enemyId, int damage)
{
    if (!_healthMap.ContainsKey(enemyId))
    {
        GD.PushWarning($"[CombatSystem] Enemy {enemyId} not in health map, ignoring damage");
        return;
    }
    
    _healthMap[enemyId] = Mathf.Max(0, _healthMap[enemyId] - damage);
}

// ❌ BAD: Direct access crashes on missing key
public int GetEnemyHealth(int enemyId)
{
    return _healthMap[enemyId]; // CRASH if enemyId not in map!
}
```

