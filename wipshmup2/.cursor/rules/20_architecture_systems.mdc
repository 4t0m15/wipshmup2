#### Spawn Methods
```csharp
// ✅ GOOD: Spawn player bullets
public Bullet SpawnBullet(string bulletType, Vector2 position, Vector2 direction)
{
    var bullet = AcquireFromPool<Bullet>(bulletType);
    if (bullet != null)
    {
        bullet.GlobalPosition = position;
        bullet.Direction = direction;
        bullet.Visible = true;
        bullet.ProcessMode = ProcessModeEnum.Inherit;
    }
    return bullet;
}

// ✅ GOOD: Spawn enemies
public Enemy SpawnEnemy(string templateId, Vector2 position, Vector2 direction)
{
    var enemy = AcquireFromPool<Enemy>(templateId);
    if (enemy != null)
    {
        enemy.GlobalPosition = position;
        enemy.Direction = direction;
        enemy.Visible = true;
        enemy.ProcessMode = ProcessModeEnum.Inherit;
    }
    return enemy;
}

// ✅ GOOD: Spawn with return-to-pool callback
public GpuParticles2D SpawnEffect(string effectType, Vector2 position)
{
    var effect = AcquireFromPool<GpuParticles2D>(effectType);
    if (effect != null)
    {
        effect.GlobalPosition = position;
        effect.Visible = true;
        effect.Emitting = true;
        // Factory automatically returns to pool when finished
    }
    return effect;
}

// ❌ BAD: Direct instantiation bypasses pooling
public void FireBullet()
{
    var bulletScene = GD.Load<PackedScene>("res://scenes/bullet.tscn");
    var bullet = bulletScene.Instantiate();
    GetTree().CurrentScene.AddChild(bullet);
}
```

#### Return to Pool
```csharp
// ✅ GOOD: Return via factory
public void OnBulletHit()
{
    EntityFactory.ReturnToPool(this, "player_bullet_basic");
}

// ✅ GOOD: Factory handles cleanup automatically
// Bullets auto-return when leaving screen bounds
// Enemies auto-return when health reaches zero

// ⚠️ MANUAL POOLING: Only needed for custom entities
public void ResetForPool()
{
    // 1. Disconnect signals
    DisconnectAllSignals();
    
    // 2. Reset transform
    GlobalPosition = Vector2.Zero;
    Rotation = 0.0f;
    Scale = Vector2.One;
    
    // 3. Reset physics
    Velocity = Vector2.Zero;
    
    // 4. Reset gameplay state
    Health = MaxHealth;
    IsAlive = true;
    
    // 5. Clear references (prevent leaks)
    TargetNode = null;
    OwnerEntity = null;
    _cachedPlayer = null;
    
    // 6. Reset visual
    Modulate = Colors.White;
    Visible = false;
    
    // 7. Disable processing
    ProcessMode = ProcessModeEnum.Disabled;
    SetPhysicsProcess(false);
    SetProcess(false);
    
    // 8. Clear timers
    _attackCooldown = 0.0f;
    _invulnerabilityTimer = 0.0f;
}
```

### Template Managers

#### EnemyTemplateManager
```csharp
public partial class EnemyTemplateManager : Node
{
    private Dictionary<string, EnemyTemplate> _templates = new();
    private EnemyTemplate _defaultTemplate;

    public EnemyTemplate GetTemplate(string templateId)
    {
        if (string.IsNullOrEmpty(templateId))
        {
            GD.PushError("[EnemyTemplateManager] Cannot load template with empty ID");
            return _defaultTemplate;
        }
        
        if (!_templates.TryGetValue(templateId, out var template))
        {
            GD.PushError($"[EnemyTemplateManager] Template not found: '{templateId}'. Available: {string.Join(", ", _templates.Keys)}");
            return _defaultTemplate;
        }
        
        return template;
    }

    public void RegisterTemplate(EnemyTemplate template)
    {
        if (template == null)
        {
            GD.PushError("[EnemyTemplateManager] Cannot register null template");
            return;
        }
        
        _templates[template.TemplateId] = template;
        GD.Print($"[EnemyTemplateManager] Registered template: {template.TemplateId}");
    }
}
```

#### BossTemplateManager
```csharp
public partial class BossTemplateManager : Node
{
    private Dictionary<string, BossTemplate> _templates = new();
    private BossTemplate _defaultTemplate;

    public BossTemplate GetTemplate(string bossId)
    {
        if (string.IsNullOrEmpty(bossId))
        {
            GD.PushError("[BossTemplateManager] Cannot load template with empty ID");
            return _defaultTemplate;
        }
        
        if (!_templates.TryGetValue(bossId, out var template))
        {
            GD.PushError($"[BossTemplateManager] Template not found: '{bossId}'. Available: {string.Join(", ", _templates.Keys)}");
            return _defaultTemplate;
        }
        
        return template;
    }

    public BossPhase GetNextPhase(string bossId, float healthPercentage)
    {
        var template = GetTemplate(bossId);
        if (template == null)
            return null;
        
        foreach (var phase in template.Phases)
        {
            if (healthPercentage <= phase.HealthThreshold)
                return phase;
        }
        
        return template.Phases.LastOrDefault();
    }
}
```

## Component-Based Enemy System

### Movement Behaviors
```csharp
// Base movement behavior
public partial class MovementBehavior : Node
{
    [Export] public float Speed { get; set; } = 100.0f;
    [Export] public Node2D TargetNode { get; set; }

    public override void _PhysicsProcess(double delta)
    {
        var parent = GetParent<Node2D>();
        if (parent == null)
            return;
        
        var direction = CalculateDirection(parent.GlobalPosition);
        parent.Position += direction * Speed * (float)delta;
    }

    protected virtual Vector2 CalculateDirection(Vector2 currentPos)
    {
        // Override in subclasses
        return Vector2.Down;
    }
}

// Example: Straight movement
public partial class StraightMovement : MovementBehavior
{
    [Export] public float RotationOffset { get; set; } = 0.0f;

    protected override Vector2 CalculateDirection(Vector2 currentPos)
    {
        return Vector2.Down.Rotated(RotationOffset);
    }
}

// Example: Homing movement
public partial class HomingMovement : MovementBehavior
{
    [Export] public float TurnSpeed { get; set; } = 2.0f;
    private Vector2 _currentDirection = Vector2.Down;

    protected override Vector2 CalculateDirection(Vector2 currentPos)
    {
        if (TargetNode == null || !IsInstanceValid(TargetNode))
            return Vector2.Down;
        
        var desiredDir = (TargetNode.GlobalPosition - currentPos).Normalized();
        _currentDirection = _currentDirection.Lerp(desiredDir, TurnSpeed * (float)GetPhysicsProcessDeltaTime());
        return _currentDirection;
    }
}
```

### Attack Behaviors
```csharp
// Base attack behavior
public partial class AttackBehavior : Node
{
    [Export] public float Cooldown { get; set; } = 2.0f;
    [Export] public string BulletType { get; set; } = "enemy_basic";
    [Export] public float BulletSpeed { get; set; } = 150.0f;

    private float _cooldownTimer = 0.0f;

    public override void _Process(double delta)
    {
        _cooldownTimer -= (float)delta;
        if (_cooldownTimer <= 0.0f)
        {
            ExecuteAttack();
            _cooldownTimer = Cooldown;
        }
    }

    protected virtual void ExecuteAttack()
    {
        // Override in subclasses
    }
}

// Example: Single shot attack
public partial class SingleShotAttack : AttackBehavior
{
    protected override void ExecuteAttack()
    {
        var parent = GetParent<Node2D>();
        if (parent == null)
            return;
        
        var bullet = EntityFactory.SpawnBullet(BulletType, parent.GlobalPosition, Vector2.Down);
        if (bullet != null)
        {
            bullet.Speed = BulletSpeed;
        }
    }
}

// Example: Spread shot attack
public partial class SpreadShotAttack : AttackBehavior
{
    [Export] public int BulletCount { get; set; } = 5;
    [Export] public float SpreadAngle { get; set; } = 45.0f;

    protected override void ExecuteAttack()
    {
        var parent = GetParent<Node2D>();
        if (parent == null)
            return;
        
        var angleStep = SpreadAngle / (BulletCount - 1);
        var startAngle = -SpreadAngle / 2.0f;
        
        for (int i = 0; i < BulletCount; i++)
        {
            var angle = startAngle + angleStep * i;
            var direction = Vector2.Down.Rotated(Mathf.DegToRad(angle));
            
            var bullet = EntityFactory.SpawnBullet(BulletType, parent.GlobalPosition, direction);
            if (bullet != null)
            {
                bullet.Speed = BulletSpeed;
            }
        }
    }
}
```

## Integration Rules

### Never Bypass Managers
```csharp
// ❌ FORBIDDEN: Direct scene instantiation
var enemyScene = GD.Load<PackedScene>("res://scenes/enemy/enemy.tscn");
var enemy = enemyScene.Instantiate();

// ✅ REQUIRED: Use EntityFactory
var enemy = EntityFactory.SpawnEnemy("popcorn_01", position, direction);

// ❌ FORBIDDEN: Direct state modification
player.Lives = 5;

// ✅ REQUIRED: Use GameState setters
GameState.SetLives(5);

// ❌ FORBIDDEN: Direct cross-system calls
GetNode<ScoreManager>("/root/ScoreManager").AddScore(100);

// ✅ REQUIRED: Use EventBus
EventBus.EmitSignal(EventBus.SignalName.EnemyDefeated, enemyId, position, 100);
```

### Event Flow Example (Complete)
```csharp
// 1. Enemy dies
public void OnHealthDepleted()
{
    EventBus.EmitSignal(EventBus.SignalName.EnemyDefeated, _enemyId, GlobalPosition, _scoreValue);
    EntityFactory.ReturnToPool(this, "enemy_popcorn");
}

// 2. ScoreManager listens to EventBus
public override void _Ready()
{
    EventBus.EnemyDefeated += OnEnemyDefeated;
}

private void OnEnemyDefeated(int enemyId, Vector2 position, int score)
{
    GameState.AddScore(score);
    CheckForItemDrop(position);
}

// 3. GameState emits score_changed
public void AddScore(int amount)
{
    var oldScore = _score;
    _score += amount;
    EmitSignal(SignalName.ScoreChanged, _score, amount);
}

// 4. UI listens to GameState
public override void _Ready()
{
    GameState.ScoreChanged += OnScoreChanged;
}

private void OnScoreChanged(int newScore, int delta)
{
    _scoreLabel.Text = $"SCORE: {newScore:D8}";
    PlayScoreIncreaseAnimation();
}
```

## Summary

Follow these C# architecture patterns:
- Use `EventBus` for all cross-system communication
- Use `GameState` for centralized state management
- Use `EntityFactory` for all entity spawning
- Use component-based design for enemies
- Use proper C# signal patterns
- Use type-safe node access
- Use proper async/await patterns
- Use proper resource loading patterns