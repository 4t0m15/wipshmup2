#### Usage Patterns
```csharp
// ✅ GOOD: Emit events instead of direct calls
public void OnHealthDepleted()
{
    EventBus.EmitSignal(EventBus.SignalName.EnemyDefeated, _enemyId, GlobalPosition, _scoreValue);
}

// Subscribe to events in _Ready()
public override void _Ready()
{
    if (!EventBus.PlayerDied.IsConnected(OnPlayerDied))
    {
        EventBus.PlayerDied += OnPlayerDied;
    }
}

// Disconnect in cleanup
public override void _ExitTree()
{
    if (EventBus.PlayerDied.IsConnected(OnPlayerDied))
    {
        EventBus.PlayerDied -= OnPlayerDied;
    }
}

// ❌ BAD: Direct cross-system calls
public void OnHealthDepleted()
{
    GetNode<ScoreManager>("/root/ScoreManager").AddScore(100); // Tight coupling!
    GetNode<AudioManager>("/root/AudioManager").PlaySfx("explosion"); // Fragile!
}
```

### GameState - Centralized State Management

#### Purpose
Single source of truth for player stats, game progress, and global state.

#### State Variables
```csharp
public partial class GameState : Node
{
    // Player Stats (Read via getters, write via setters that emit signals)
    private int _lives = 3;
    private int _bombs = 3;
    private int _score = 0;
    private int _continuesUsed = 0;
    private int _powerLevel = 1;
    private int _maxPower = 4;

    // Game Progress
    private int _currentStage = 1;
    private int _currentWave = 0;
    private Difficulty _difficulty = Difficulty.Normal;
    private float _rank = 0.0f; // Dynamic difficulty from 0.0 to 10.0

    // Chain and Combo System
    private int _chainCount = 0;
    private float _chainTimer = 0.0f;
    private float _scoreMultiplier = 1.0f;

    // Game Flow Flags
    private bool _isPaused = false;
    private bool _isGameOver = false;
    private bool _isBossActive = false;
    private bool _playerIsAlive = true;

    // Public Properties
    public int Lives => _lives;
    public int Bombs => _bombs;
    public int Score => _score;
    public int ContinuesUsed => _continuesUsed;
    public int PowerLevel => _powerLevel;
    public int MaxPower => _maxPower;
    public int CurrentStage => _currentStage;
    public int CurrentWave => _currentWave;
    public Difficulty Difficulty => _difficulty;
    public float Rank => _rank;
    public int ChainCount => _chainCount;
    public float ScoreMultiplier => _scoreMultiplier;
    public bool IsPaused => _isPaused;
    public bool IsGameOver => _isGameOver;
    public bool IsBossActive => _isBossActive;
    public bool PlayerIsAlive => _playerIsAlive;
}
```

#### Access Patterns
```csharp
// ✅ GOOD: Read via getters
var currentLives = GameState.Lives;
var playerScore = GameState.Score;

// ✅ GOOD: Write via setters (emits change signals)
GameState.AddScore(100); // Emits score_changed signal
GameState.ConsumeBomb(); // Emits bomb_used signal, updates count
GameState.LoseLife(); // Emits life_lost signal, may trigger game over

// ✅ GOOD: Query flags
if (GameState.IsBossActive)
{
    AdjustSpawningLogic();
}

// ❌ BAD: Direct state duplication
public partial class Player : Node2D
{
    private int _lives = 3; // Don't duplicate GameState.Lives!
}

// ❌ BAD: External modification without setters
public void TakeDamage()
{
    GameState._lives -= 1; // Bypasses validation and signals!
}
```

### EntityFactory - Object Pooling System

#### Purpose
Centralized spawning with object pooling for performance. Manages lifecycle of all dynamic entities.

#### Pool Configuration
```csharp
public partial class EntityFactory : Node
{
    // Pre-configured pool limits
    private static readonly Dictionary<string, int> PoolLimits = new()
    {
        // Player bullets (high frequency, small footprint)
        ["player_bullet_basic"] = 200,
        ["player_bullet_focused"] = 150,
        ["player_bullet_homing"] = 50,
        
        // Enemy bullets (very high frequency during boss fights)
        ["enemy_bullet_basic"] = 300,
