; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="wipshmup2"
run/main_scene="res://scenes/main/EpilepsyWarning.tscn"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

AudioManager="*res://scripts/autoload/AudioManager.gd"
SafetyWrapper="*res://scripts/autoload/SafetyWrapper.gd"
DifficultyConfig="*res://scripts/core/DifficultyConfig.cs"
RankManager="*res://scripts/core/RankManager.cs"
ItemDropManager="*res://scripts/core/ItemDropManager.cs"
SpriteManager="*res://scripts/core/SpriteManager.cs"
BulletPatterns="*res://scripts/core/BulletPatterns.cs"
EventBus="*res://scripts/autoload/EventBus.cs"
GameState="*res://scripts/autoload/GameState.cs"
EntityFactory="*res://scripts/autoload/EntityFactory.cs"
EnemyTemplateManager="*res://scripts/autoload/EnemyTemplateManager.cs"
BossTemplateManager="*res://scripts/autoload/BossTemplateManager.cs"
StageTemplateManager="*res://scripts/autoload/StageTemplateManager.gd"
GameModeManager="*res://scripts/autoload/GameModeManager.gd"
ConfigManager="*res://scripts/autoload/ConfigManager.gd"
CombatSystem="*res://scripts/systems/CombatSystem.gd"
BulletReadability="*res://scripts/bullet_readability/BulletReadabilitySettings.gd"
ErrorHandler="*res://scripts/autoload/ErrorHandler.gd"
StabilityManager="*res://scripts/autoload/StabilityManager.gd"
ParallelProcessor="*res://scripts/autoload/ParallelProcessor.gd"
TestingFramework="*res://scripts/autoload/TestingFramework.gd"
DevelopmentWorkflow="*res://scripts/autoload/DevelopmentWorkflow.gd"
MemoryManager="*res://scripts/autoload/MemoryManager.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/mode="exclusive_fullscreen"
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="wipshmup2"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg")

[input]

bomb={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":88,"key_label":0,"unicode":120,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194325,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
#renderer/rendering_method="gl_compatibility"
textures/default_texture_filter=0
2d/snapping/use_gpu_pixel_snap=true
